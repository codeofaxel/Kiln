---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallTabs from '../components/InstallTabs.astro';

// Install page rebuilt 2026-04-26 for the AI-agent-first happy
// path.  Three steps: install -> connect agent -> ask.  The legacy
// CLI tour (kiln setup / verify / status / serve) is hidden because
// the agent's MCP runtime invokes those itself once the JSON config
// is pasted; users who want to drive manually find them in the docs
// + FAQ.  The advanced tabs (pipx / source / one-line installer)
// stay reachable behind a <details> disclosure so the happy path on
// top stays visually tight.
//
// Pro CTA routes to /pricing, NOT direct-to-Stripe, so the
// commercial-use modal in pricing.astro can route Etsy / Shopify
// sellers to Business instead of shipping them the wrong tier.
//
// 2026-06-11: step 2 now leads with `kiln signin` + `kiln install-mcp`
// (auto-config for Claude Desktop / Claude Code / Codex) — the same
// flow the Windows tab and the GitHub README teach.  The manual JSON
// config stays one <details> fold away for other MCP clients.
//
// 2026-06-12: normie pass.  Copy says what the user experiences
// ("connects Kiln to your AI apps"), never the mechanism ("merges
// MCP configs").  The Windows tab's "let your AI install it" prompt
// is promoted to a platform-neutral callout at the top of step 1 —
// for non-technical visitors, the AI they already have IS the
// installer.  Keep this page and the README Quick Start in lockstep.

const mcpConfig = JSON.stringify({
  mcpServers: {
    kiln: {
      command: "python3",
      args: ["-m", "kiln", "serve"]
    }
  }
}, null, 2);

const mcpConfigCompact = JSON.stringify({
  mcpServers: {
    kiln: {
      command: "python3",
      args: ["-m", "kiln", "serve"]
    }
  }
});

const connectCommands = 'kiln signin\nkiln install-mcp';
const connectCommandsDisplay =
  'kiln signin        # create your free account\n' +
  'kiln install-mcp   # connects Kiln to your AI apps';

// One prompt that hands the entire setup to an AI that can run
// commands (Claude Code, Codex, ...).  Platform-neutral version of
// the Windows tab's "fastest" path.
const agentSetupPrompt =
  'Set up Kiln (kiln3d.com) on my computer. If Python 3.10+\n' +
  "isn't installed, install it first. Then run pip install kiln3d.\n" +
  'Then run kiln signin, then kiln install-mcp to connect Kiln\n' +
  'to this agent. Finish with kiln doctor and show me the result.\n' +
  'Tell me if I need to restart anything.';

const installHowToSchema = {
  '@type': 'HowTo',
  name: 'How to install Kiln for AI-powered 3D printing',
  description:
    'Install Kiln, connect any MCP-capable AI agent, and ask it to design and print an object.',
  totalTime: 'PT3M',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Install Kiln',
      text: 'Paste one setup prompt into an AI that can run commands and it installs Kiln for you — or install it yourself with pip install kiln3d.',
      url: 'https://kiln3d.com/install',
    },
    {
      '@type': 'HowToStep',
      name: 'Connect your AI',
      text: 'Run kiln signin then kiln install-mcp — Kiln connects itself to Claude Desktop, Claude Code, and Codex. Any other MCP-compatible app gets a paste-in config via kiln install-mcp --print.',
      url: 'https://kiln3d.com/install',
    },
    {
      '@type': 'HowToStep',
      name: 'Ask',
      text: 'Paste a sentence describing the object you want into your agent. Kiln designs, slices, and prints it.',
      url: 'https://kiln3d.com/install',
    },
  ],
};
---

<BaseLayout
  title="Install Kiln — AI 3D Printing Infrastructure"
  description="Install Kiln in three minutes on macOS, Windows, Linux, or WSL 2. Connect any MCP-capable AI agent (Claude Desktop, Claude Code, Codex) and ask it to make something."
  current="install"
  keywords={[
    'install kiln',
    'kiln setup',
    'kiln mcp server',
    '3d printer ai setup',
    'octoprint ai agent tools',
  ]}
  schema={installHowToSchema}
>
  <!-- Mini-hero — paradigm echo from the landing page.  One
       sentence in the page-hero voice so /install reads as the next
       sentence in the same conversation the visitor started one
       click ago. -->
  <div class="page-hero">
    <div class="container">
      <h1 class="install-headline">Three minutes. Then ask your AI to <span class="serif-accent ink-ember">make something.</span></h1>
    </div>
  </div>

  <!-- Three steps — install, connect, ask.  Each step exposes one
       copyable line (or one config block) and zero extra ceremony. -->
  <section class="install-steps">
    <div class="container">
      <ol class="steps">
        <li data-reveal>
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Install Kiln</h3>
            <p class="install-expect">Here&rsquo;s what happens: you&rsquo;ll install a few free tools (Python, Kiln, and OpenSCAD &mdash; the engine Kiln designs with), connect Kiln to your AI app, then ask it to make something. There&rsquo;s a download or two, so give it a few minutes.</p>
            <div class="agent-setup-callout">
              <p class="agent-setup-label">Easiest &mdash; let your AI do the whole thing</p>
              <p class="agent-setup-body">Using Claude Code, Codex, or another AI that can run commands on your computer? Paste this to it and it installs and connects Kiln for you &mdash; no terminal needed:</p>
              <div class="code-block">
                <button class="copy-btn" data-code={agentSetupPrompt}>Copy</button>
                <pre><code set:text={agentSetupPrompt} /></pre>
              </div>
              <p class="agent-setup-note"><strong>Using Claude Desktop?</strong> It can&rsquo;t run commands for you, so this prompt won&rsquo;t install anything &mdash; that&rsquo;s the snag most people hit. Use the manual steps below instead: you&rsquo;ll paste a couple of lines into Terminal once, and we tell you exactly what each one does.</p>
            </div>
            <p>Or do it yourself &mdash; pick your platform below (this is the path for Claude Desktop). Each has copy-paste commands.</p>
            <InstallTabs />
          </div>
        </li>
        <li data-reveal>
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Connect your AI</h3>
            <p>Two quick commands &mdash; Kiln sets itself up inside Claude Desktop, Claude Code, and Codex.</p>
            <div class="code-block">
              <button class="copy-btn" data-code={connectCommands}>Copy</button>
              <pre><code set:text={connectCommandsDisplay} /></pre>
            </div>
            <p>Restart your AI app and it can run your printer. <span class="step-skip">(Used the easiest path in step 1? This already happened.)</span></p>
            <p class="install-success"><strong>How you&rsquo;ll know it worked:</strong> ask your AI &ldquo;is Kiln connected?&rdquo; and it&rsquo;ll confirm Kiln is loaded and ready. That&rsquo;s it &mdash; you&rsquo;re set up.</p>
            <details class="manual-config">
              <summary>Using a different AI app? Paste the config yourself</summary>
              <p><code>kiln install-mcp --print</code> prints this for any MCP-compatible app:</p>
              <div class="code-block">
                <button class="copy-btn" data-code={mcpConfigCompact}>Copy</button>
                <pre><code set:text={mcpConfig} /></pre>
              </div>
            </details>
          </div>
        </li>
        <li data-reveal>
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Ask &mdash; and here&rsquo;s what to say first</h3>
            <p>Once Kiln is connected, just describe what you want in plain English &mdash; no special commands. Try something like:</p>
            <blockquote class="example-prompt">I have a Bambu A1, make me a coaster with my dog&rsquo;s photo on it</blockquote>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Pro CTA — post-value, not pre-value.  Free tier covers the
       first prints; Pro is framed as graduation to the full
       workflow, not a gate.  Button routes to /pricing so the
       commercial-use modal there can move Etsy/Shopify sellers to
       Business.  Single button, single price; tier comparison
       happens at /pricing. -->
  <section class="pro-cta-section">
    <div class="container">
      <div class="pro-cta-card" data-reveal>
        <h2 class="pro-cta-headline">You&rsquo;re ready to print.</h2>
        <p class="pro-cta-body">
          Free covers your first prints.  Pro covers the rest of the
          workflow &mdash; version your designs, modify them mid-print,
          and leave the room while your agent handles the rest.
        </p>
        <a href="/pricing" class="btn pro-cta-btn">Get Pro &rarr;</a>
        <p class="pro-cta-price">$49 / month</p>
        <p class="pro-cta-signin">
          Or <a href="https://app.kiln3d.com/connect">sign in free &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Quiet footnote link — the page's last shout is the Pro CTA
       above; this is a one-line footnote that routes the stuck
       visitor to the canonical FAQ page rather than re-rendering
       the questions inline.  Anchor lands inside the Setup &
       Troubleshooting section so the visitor doesn't have to
       scroll past the General questions to find help. -->
  <section class="faq-link-section">
    <div class="container">
      <!-- Staying-current footnote — reassurance, not a step: once
           installed, the update nudge means a new release won't slip
           past a returning user, so they needn't re-check this page. -->
      <p class="faq-link">
        Once installed, Kiln tells you when there&rsquo;s a new version &mdash; run <code>kiln self-update</code> to upgrade, so you never have to check back here.
      </p>
      <p class="faq-link">
        Stuck on install? <a href="/faq#setup-troubleshooting">See common questions &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page-hero h1 keeps a slightly tighter max-width than the global
     default so the sentence breaks into two balanced lines. */
  .install-headline {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Three-step list — same .step-number / .step-content shape the
     legacy install page used so the typography stays familiar. */
  .install-steps {
    padding: 0 0 56px;
  }
  .steps {
    list-style: none;
    padding: 0;
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .steps li {
    display: flex;
    gap: 28px;
    padding: 44px 0;
    border-bottom: 1px solid var(--border);
  }
  .steps li:last-child {
    border-bottom: none;
  }
  .step-number {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(180deg, rgba(255, 107, 43, 0.14), rgba(255, 107, 43, 0.05));
    color: var(--accent);
    font-weight: 600;
    font-size: 16px;
    border: 1px solid var(--border-accent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .step-content {
    flex: 1;
    min-width: 0;
  }
  .step-content h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin-bottom: 8px;
  }
  .step-content p {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 4px;
    line-height: 1.6;
  }
  .step-content .code-block {
    margin: 12px 0 0;
  }
  .step-content pre {
    margin: 0;
    white-space: pre;
  }
  .step-content pre code {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--text);
    background: transparent;
    padding: 0;
    border: none;
  }
  /* "Let your AI install it" callout (Step 1) — accent-tinted card
     matching the InstallTabs .wsl-note treatment.  For visitors who
     aren't comfortable in a terminal, the AI they already have is
     the installer; the prompt is the entire setup. */
  .agent-setup-callout {
    margin: 18px 0 26px;
    padding: 20px 22px 22px;
    background: linear-gradient(180deg, rgba(255, 107, 43, 0.08), rgba(255, 107, 43, 0.03));
    border: 1px solid rgba(255, 107, 43, 0.2);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  .agent-setup-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 6px;
  }
  .agent-setup-body {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }
  /* Quiet aside on the step-2 restart line for visitors who used
     the step-1 callout. */
  .step-skip {
    opacity: 0.75;
  }

  /* Key onboarding lines — "what to expect", the Claude Desktop snag,
     and the success check.  Rendered at full --text (not --text-muted)
     so the instructions win the contrast fight with the accent prompt
     card; normie feedback was that gray instructions got lost next to
     the brighter prompt. */
  .install-expect {
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    margin-bottom: 6px;
  }
  .agent-setup-note {
    font-size: 13.5px;
    color: var(--text);
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 107, 43, 0.18);
    line-height: 1.6;
  }
  .agent-setup-note strong { color: var(--accent-bright, var(--accent)); }
  .install-success {
    font-size: 14px;
    color: var(--text);
    margin-top: 8px;
    line-height: 1.6;
  }
  .install-success strong { color: var(--accent-bright, var(--accent)); }

  /* Manual-config fold (Step 2) — muted disclosure matching the
     .faq-link footnote register so the happy path stays one command
     tall; the JSON only renders for visitors who ask for it. */
  .manual-config {
    margin: 14px 0 0;
  }
  .manual-config summary {
    font-size: 13px;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
    transition: color 0.15s;
  }
  .manual-config summary:hover {
    color: var(--text);
  }
  .manual-config[open] summary {
    margin-bottom: 4px;
  }
  .manual-config p {
    font-size: 13px;
    margin: 8px 0 0;
  }

  /* Example prompt (Step 3) — chat-bubble shape, accent left
     border, italic so the visitor parses it as "what you'd say to
     your AI" rather than as another code block. */
  .example-prompt {
    display: inline-block;
    margin: 14px 0 0;
    padding: 14px 22px;
    background: rgba(255, 107, 43, 0.06);
    border: 1px solid rgba(255, 107, 43, 0.2);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    font-style: italic;
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
    quotes: "\201C" "\201D";
  }
  .example-prompt::before { content: open-quote; }
  .example-prompt::after { content: close-quote; }

  /* Pro CTA card — single floating card, post-value placement.
     One button, one price, no tier table; tier comparison + the
     commercial-use modal both live at /pricing. */
  .pro-cta-section {
    padding: 16px 0 64px;
  }
  .pro-cta-card {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding: 56px 40px 48px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(420px 200px at 50% 0%, rgba(255, 107, 43, 0.07), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      var(--bg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 24px 60px -32px rgba(0, 0, 0, 0.8);
  }
  .pro-cta-headline {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -0.028em;
    margin: 0 0 16px;
    color: var(--text);
  }
  .pro-cta-body {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0 auto 28px;
    max-width: 480px;
    text-wrap: pretty;
  }
  .pro-cta-btn {
    font-size: 15px;
  }
  .pro-cta-price {
    font-size: 13px;
    color: var(--text-muted);
    margin: 14px 0 0;
    letter-spacing: 0.01em;
  }

  /* Free-tier escape hatch — sits below the Pro price line as a
     tertiary aside in the same eye-position as the Pro CTA button.
     Muted styling matches the .faq-link footnote pattern (dashed
     underline, text-muted, accent-on-hover) so it reads as "not
     ready yet, here's the free path" rather than as a second CTA
     competing with Get Pro. */
  .pro-cta-signin {
    font-size: 13px;
    color: var(--text-muted);
    margin: 10px 0 0;
    letter-spacing: 0.01em;
  }
  .pro-cta-signin a {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px dashed var(--border);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .pro-cta-signin a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Quiet FAQ link footnote — sits below the Pro CTA + advanced
     install disclosure as a single muted line.  Centered, small,
     no border, no card.  It doesn't compete with the Pro
     CTA's confidence; reads like a polite aside. */
  .faq-link-section {
    padding: 8px 0 80px;
  }
  .faq-link {
    text-align: center;
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }
  .faq-link a {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px dashed var(--border);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .faq-link a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 640px) {
    .steps li {
      flex-direction: column;
      gap: 14px;
      padding: 32px 0;
    }
    .pro-cta-card {
      padding: 36px 22px;
    }
  }
</style>

<script>
  // Copy-to-clipboard for all code blocks on the page
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') || '';
      try {
        await navigator.clipboard.writeText(code);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        btn.style.borderColor = 'var(--accent)';
        btn.style.color = 'var(--accent)';
        setTimeout(() => {
          btn.textContent = original;
          btn.style.borderColor = '';
          btn.style.color = '';
        }, 1500);
      } catch {
        // Fallback for non-HTTPS contexts
        const textarea = document.createElement('textarea');
        textarea.value = code;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1500);
      }
    });
  });
</script>
