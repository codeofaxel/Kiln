---
/**
 * /features — the full capability matrix.
 *
 * Exists because the homepage keeps the FeatureGrid focused at five
 * cards.  The ten other capabilities still matter for SEO and for
 * engineers verifying the toolbox is deep, so they live here.
 *
 * Uses the same FeatureGrid component with no `limit` prop so all
 * fifteen cards render in order.  Keep the copy in the component
 * as the single source of truth — do not inline features here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="Kiln features | Capabilities for AI-driven 3D printing"
  description="What Kiln ships — text & sketch to 3D generation, Git for 3D printing, printability analysis, multi-part assembly, autonomous failure recovery, fleet orchestration, and more."
  keywords={[
    'kiln 3d features',
    'ai 3d printer capabilities',
    'text to 3d model',
    'git for 3d printing',
    'autonomous 3d printing',
    'printability analysis',
  ]}
>
  <div class="page-hero">
    <div class="container">
      <h1>What Kiln can do.</h1>
      <p class="lead">
        Design, printability, lifecycle, fleet, safety, and the agent protocol that ties them together &mdash; every capability currently shipping.
      </p>
    </div>
  </div>

  <FeatureGrid />

  <CTA />
</BaseLayout>
