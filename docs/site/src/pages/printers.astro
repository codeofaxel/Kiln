---
import BaseLayout from '../layouts/BaseLayout.astro';
import supported from '../data/supported_printers.json';

const { brands, total_models, total_brands } = supported;

const brandNames = brands.map((b) => b.brand).join(', ');

const fmtVol = (v: number[] | null) =>
  Array.isArray(v) && v.length === 3 ? `${v[0]} × ${v[1]} × ${v[2]} mm` : '';

// schema.org ItemList of every supported model (SEO long-tail).
const schema = {
  '@type': 'ItemList',
  name: 'Printers supported by Kiln',
  numberOfItems: total_models,
  itemListElement: brands
    .flatMap((b) => b.models.map((m) => m.name))
    .map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })),
};
---

<BaseLayout
  title="Supported 3D printers — every brand & model Kiln works with"
  description={`Kiln ships tuned profiles for ${total_models} printer models across ${total_brands} brands — ${brandNames}. Check if your printer is supported, plus any Klipper, Marlin, Bambu, Prusa, or OctoPrint machine.`}
  current="printers"
  keywords={[
    'kiln supported printers',
    'does kiln support my printer',
    '3d printer compatibility',
    'bambu lab ai tools',
    'creality ender 3 ai',
    'sovol sv07 klipper',
    'elegoo neptune ai tools',
    'prusa mk4 ai',
    'voron klipper automation',
  ]}
  schema={schema}
>
  <section class="printers-hero">
    <div class="container">
      <span class="eyebrow">Compatibility</span>
      <h1>Every printer Kiln supports</h1>
      <p class="lead">
        Kiln ships tuned profiles — real build volume, temperature limits, supported materials, and a
        tuned slicer profile — for <strong>{total_models} models across {total_brands} brands</strong>.
        Find yours below. Running something else? Any Klipper (Moonraker), Marlin (USB), Bambu, Prusa
        Link, or OctoPrint-connected printer works too, with safe generic settings.
      </p>
      <div class="filter-wrap">
        <input
          id="printer-filter"
          type="search"
          autocomplete="off"
          placeholder="Type your printer — “Ender 3”, “X1C”, “SV07”, “Neptune”…"
          aria-label="Filter supported printers"
        />
        <p class="filter-empty" id="filter-empty" hidden>
          No exact match — but if it runs Klipper, Marlin, Bambu, Prusa, or OctoPrint, Kiln still
          drives it. See the <a href="https://github.com/codeofaxel/Kiln/blob/main/docs/COMPATIBILITY.md">compatibility notes</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="brands-section">
    <div class="container">
      <div class="brand-list">
        {brands.map((b) => (
          <details class="brand" data-brand={b.brand}>
            <summary>
              <span class="brand-name">{b.brand}</span>
              <span class="brand-count">{b.model_count} {b.model_count === 1 ? 'model' : 'models'}</span>
            </summary>
            <ul class="model-list">
              {b.models.map((m) => (
                <li class="model" data-name={m.name.toLowerCase()}>
                  <span class="model-name">{m.name}</span>
                  {fmtVol(m.build_volume_mm) && <span class="model-vol">{fmtVol(m.build_volume_mm)}</span>}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

      <p class="catch-all">
        Don’t see your exact model? Kiln connects through seven backends — OctoPrint, Moonraker/Klipper,
        Creality, Bambu Lab, Prusa Link, Elegoo, and Direct USB — so most consumer and prosumer FDM
        printers work even without a named profile. See the
        <a href="/integrations">integrations</a> page for connection details, or the
        <a href="https://github.com/codeofaxel/Kiln/blob/main/docs/COMPATIBILITY.md">full compatibility matrix</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('printer-filter') as HTMLInputElement | null;
  const empty = document.getElementById('filter-empty');
  const brandEls = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.brand'));

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let anyBrandVisible = false;

    brandEls.forEach((d) => {
      const brand = (d.dataset.brand || '').toLowerCase();
      const brandMatch = !q || brand.includes(q);
      let modelMatch = false;

      d.querySelectorAll<HTMLLIElement>('li.model').forEach((li) => {
        const match = !q || brandMatch || (li.dataset.name || '').includes(q);
        li.hidden = !match;
        if (match) modelMatch = true;
      });

      const visible = brandMatch || modelMatch;
      d.hidden = !visible;
      d.open = Boolean(q) && visible;
      if (visible) anyBrandVisible = true;
    });

    if (empty) empty.hidden = !(q && !anyBrandVisible);
  });
</script>

<style>
  .printers-hero {
    text-align: center;
    padding: 88px 0 36px;
  }
  .eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid rgba(255, 107, 43, 0.25);
    border-radius: 20px;
    padding: 3px 12px;
    margin-bottom: 14px;
  }
  .printers-hero h1 {
    font-size: clamp(30px, 4.5vw, 48px);
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .printers-hero .lead {
    max-width: 720px;
    margin: 0 auto 28px;
  }
  .filter-wrap {
    max-width: 520px;
    margin: 0 auto;
  }
  #printer-filter {
    width: 100%;
    padding: 14px 18px;
    font-size: 16px;
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    outline: none;
    transition: border-color 0.15s ease;
  }
  #printer-filter:focus {
    border-color: var(--accent);
  }
  .filter-empty {
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  .brands-section {
    padding: 8px 0 80px;
  }
  .brand-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    align-items: start;
  }
  .brand {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .brand[open] {
    border-color: var(--accent);
  }
  .brand summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .brand summary::-webkit-details-marker {
    display: none;
  }
  .brand summary::after {
    content: '+';
    margin-left: auto;
    font-size: 20px;
    color: var(--text-muted);
    line-height: 1;
  }
  .brand[open] summary::after {
    content: '–';
    color: var(--accent);
  }
  .brand-name {
    font-weight: 600;
    font-size: 17px;
  }
  .brand-count {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .model-list {
    list-style: none;
    margin: 0;
    padding: 0 20px 16px;
    border-top: 1px solid var(--border);
  }
  .model {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
  }
  .model:last-child {
    border-bottom: none;
  }
  .model-name {
    font-size: 14px;
  }
  .model-vol {
    font-size: 12px;
    color: var(--text-muted);
    font-family: var(--mono);
    white-space: nowrap;
  }
  .catch-all {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.7;
    max-width: 760px;
  }

  @media (max-width: 720px) {
    .printers-hero {
      padding: 60px 0 24px;
    }
    .brand-list {
      grid-template-columns: 1fr;
    }
  }
</style>
