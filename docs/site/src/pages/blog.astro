---
import BaseLayout from '../layouts/BaseLayout.astro';

// Single source of truth for the blog index. To add a post: drop ONE entry
// here (newest first). The cards below and the JSON-LD schema both render
// from this array via .map(), so a post can never get half-listed again.
// `excerpt` is the card blurb (HTML allowed); the schema description is
// derived from it (tags stripped, common entities decoded).
const posts = [
  {
    title: 'Kiln 1.1.6: printers that show up on their own, and cloud sync that turns on by asking',
    url: '/blog/kiln-1-1-6',
    date: 'May 29, 2026',
    datePublished: '2026-05-29',
    excerpt: `Printers show up on their own: Bambu Lab machines now appear in a network scan, and prints go to the right AMS spool automatically. The anonymous learning that sharpens Kiln never gets lost when the network drops. On Kiln Pro, turn on cloud sync just by asking, and imported multi-part models get their own parts manual.`,
    tags: ['release', 'v1.1.6', 'printer-discovery', 'ams', 'community-learning', 'cloud-sync'],
  },
  {
    title: 'Kiln 1.1.5: engravings that read right, and nozzle-wear awareness on Pro',
    url: '/blog/kiln-1-1-5',
    date: 'May 28, 2026',
    datePublished: '2026-05-28',
    excerpt: `Engraving text into your prints just works now: the carve depth matches your nozzle, the right flip is picked for you, a check catches text that would print backwards before you slice, and you get an auto preview of the finished face. On Kiln Pro, Kiln keeps an eye on each printer&rsquo;s nozzle wear and factors it into failure analysis, material recommendations, and recovery.`,
    tags: ['release', 'v1.1.5', 'engraving', 'nozzle-wear', 'prusa'],
  },
  {
    title: 'Kiln 1.1.4: native support for Windows machines, and sharper overhang checks',
    url: '/blog/kiln-1-1-4',
    date: 'May 21, 2026',
    datePublished: '2026-05-21',
    excerpt: `Kiln now runs on a stock Windows machine &mdash; CLI, install, and OpenSCAD design generation &mdash; with a copy-paste prompt that hands the whole setup to an AI agent. Plus sharper overhang verdicts (cantilevers and floating islands correctly keep their supports flag), honest AMS Lite filament readings on the Bambu A1 and A1 mini, and safety messages in plain language.`,
    tags: ['release', 'v1.1.4', 'windows', 'overhangs', 'ams', 'supports'],
  },
  {
    title: 'Kiln 1.1.2 + 1.1.3: recovery you can see, analysis you can trust',
    url: '/blog/kiln-1-1-3',
    date: 'May 19, 2026',
    datePublished: '2026-05-19',
    excerpt: `Two releases in one. Vision-detected mid-print failures now drive auto-recovery on Pro, hole-aware printability learns your printer&rsquo;s drift, and adhesion analysis flags tall narrow towers before the print starts. Saved design goals carry through reprints and version saves, and free-tier discovery tools return real results on every install.`,
    tags: ['release', 'v1.1.2', 'v1.1.3', 'recovery', 'printability'],
  },
  {
    title: 'Kiln 1.1.1: Tighter feedback loop',
    url: '/blog/kiln-1-1-1-tighter-feedback-loop',
    date: 'May 13, 2026',
    datePublished: '2026-05-13',
    excerpt: `A tighter loop between your AI agent and your 3D printer: clearer camera-monitoring events, better in-print failure detection on Pro, and a <code>kiln health</code> command that repairs its own broken paths after a Python reinstall. Plus a handful of polish fixes across the agent and web surfaces.`,
    tags: ['release', 'v1.1.1', 'vision', 'kiln-health', 'polish'],
  },
  {
    title: 'Kiln 1.1: Calibrated to your printer',
    url: '/blog/kiln-1-1-calibrated-to-your-printer',
    date: 'May 6, 2026',
    datePublished: '2026-05-06',
    excerpt: `Per-printer calibration grounding &mdash; Kiln reads your existing OrcaSlicer / Bambu Studio / PrusaSlicer profile and uses it on every slice, then keeps learning from every print (Pro). Plus a dedicated <code>tablet_stand</code> template (iPads tip backward when stuck on phone-stand bases), engineering depth on all 18 design templates with the formulas baked in, and a tier diagnostic that just answers "what plan am I on?"`,
    tags: ['release', 'v1.1', 'calibration', 'design-templates', 'tier-diagnostic'],
  },
  {
    title: 'Kiln 1.0: The Agent-Native Manufacturing Layer',
    url: '/blog/kiln-1-0-agent-native-manufacturing-layer',
    date: 'April 29, 2026',
    datePublished: '2026-04-29',
    excerpt: `Kiln 1.0 is real infrastructure, not an experiment: Git-for-3D workflows, recovery, decoration, assembly manuals, and a repository-style web workshop for physical objects &mdash; one interface for OctoPrint, Moonraker, Bambu Lab, Elegoo, and Prusa Link.`,
    tags: ['release', 'mcp', 'cli', 'v1.0'],
  },
  {
    title: 'Kiln is Now One Install Away from Any AI Agent',
    url: '/blog/one-install-away',
    date: 'February 20, 2026',
    datePublished: '2026-02-20',
    excerpt: `Kiln ships to PyPI, ClawHub, and the MCP Registry simultaneously &mdash; one command to install for 3D printer control. <code>pip install kiln3d</code>, <code>clawhub install kiln</code>, or search "kiln" in your MCP client. All three paths, same destination.`,
    tags: ['release', 'pypi', 'mcp', 'clawhub'],
  },
  {
    title: 'Think → Print → Earn: 12 New Subsystems Ship Today',
    url: '/blog/think-print-earn',
    date: 'February 19, 2026',
    datePublished: '2026-02-19',
    excerpt: `Kiln now covers the entire loop &mdash; from AI-generated 3D models to validated prints to marketplace revenue. Generation registry, printability analysis, auto-orientation, marketplace publishing with print certificates, revenue tracking, intelligent failure recovery, and more.`,
    tags: ['features', 'generation', 'marketplace', 'revenue'],
  },
  {
    title: 'Craftcloud Integration Is Live',
    url: '/blog/craftcloud-live',
    date: 'February 18, 2026',
    datePublished: '2026-02-18',
    excerpt: `Kiln now supports outsourced 3D printing through Craftcloud's network of print services &mdash; FDM, SLA, SLS, MJF, and metal. Your AI agent can get quotes and place orders through the hosted fulfillment path or direct mode with your own provider credentials.`,
    tags: ['integration', 'fulfillment', 'craftcloud'],
  },
  {
    title: 'Our First Real Prints: Two Users, Two Printers, Zero Manual Steps',
    url: '/blog/first-real-prints',
    date: 'February 18, 2026',
    datePublished: '2026-02-18',
    excerpt: `Two users printed coasters end-to-end with AI agents &mdash; different agents, different printer brands (Bambu Lab A1 Mini and Prusa Mini), no human intervention. Here's what happened, with video.`,
    tags: ['demo', 'real hardware', 'community'],
  },
  {
    title: 'Introducing Kiln: Let AI Agents Run Your 3D Printers',
    url: '/blog/introducing-kiln',
    date: 'February 17, 2026',
    datePublished: '2026-02-17',
    excerpt: `Open-source infrastructure that lets AI agents safely control 3D printers. It's free, it runs locally, and it's available right now &mdash; one interface for OctoPrint, Moonraker, Bambu Lab, Elegoo, and Prusa Link, with safety profiles built in.`,
    tags: ['launch', 'open source', 'v0.1.0'],
  },
];

// Derive a clean plain-text description for JSON-LD from the card excerpt.
const schemaDescription = (excerpt) =>
  excerpt
    .replace(/&mdash;/g, '—')
    .replace(/&rsquo;/g, '’')
    .replace(/&ldquo;/g, '“')
    .replace(/&rdquo;/g, '”')
    .replace(/<[^>]+>/g, '');

const blogSchema = [
  {
    '@type': 'Blog',
    name: 'Kiln Blog',
    url: 'https://kiln3d.com/blog',
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.title,
      url: `https://kiln3d.com${post.url}`,
      datePublished: post.datePublished,
      description: schemaDescription(post.excerpt),
    })),
  },
  {
    '@type': 'ItemList',
    name: 'Kiln Blog Posts',
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title,
      url: `https://kiln3d.com${post.url}`,
    })),
  },
];
---

<BaseLayout
  title="Kiln Blog — AI 3D Printing Infrastructure and Product Updates"
  description="Updates, tutorials, integration launches, and technical deep dives from the Kiln 3D printing infrastructure project."
  current="blog"
  keywords={[
    'kiln blog',
    '3d printing infrastructure news',
    'ai agent manufacturing updates',
    'mcp server 3d printing',
  ]}
  schema={blogSchema}
>
  <div class="blog-page">
    <div class="container">
      <header class="blog-header">
        <h1>What's New in Kiln</h1>
        <p class="lead">Updates, releases, and announcements from the Kiln project.</p>
      </header>

      <div class="posts">
        {posts.map((post) => (
          <article class="post-card">
            <div class="post-meta">{post.date}</div>
            <h2><a href={post.url}>{post.title}</a></h2>
            <p set:html={post.excerpt} />
            <div class="post-tags">
              {post.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <a href={post.url} class="read-more">Read the full post &rarr;</a>
          </article>
        ))}
      </div>

      <div class="blog-cta">
        <p>Follow development on <a href="https://github.com/codeofaxel/Kiln" target="_blank" rel="noopener">GitHub</a> for the latest updates.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-page {
    padding: 80px 0 100px;
  }
  .blog-header {
    margin-bottom: 48px;
  }
  .blog-header h1 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .lead {
    color: var(--text-muted);
    font-size: 16px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 48px;
  }

  .post-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 32px;
  }
  .post-meta {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .post-card h2 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .post-card h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .post-card h2 a:hover {
    color: var(--accent);
  }
  .post-card p {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .post-tags {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .tag {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid rgba(255, 107, 43, 0.25);
    padding: 3px 10px;
    border-radius: 12px;
  }

  .read-more {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .read-more:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .blog-cta {
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .blog-page { padding: 50px 0 60px; }
    .blog-header h1 { font-size: 28px; }
    .post-card { padding: 24px; }
    .post-card h2 { font-size: 19px; }
  }
</style>
