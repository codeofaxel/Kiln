---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { marked } from 'marked';

// Read TERMS_OF_USE.md at the repo root at build time.  Canonical copy
// lives there alongside PRIVACY.md so contributors + auditors see
// the same document the site renders.
const mdPath = resolve(process.cwd(), '../../TERMS_OF_USE.md');
const markdown = readFileSync(mdPath, 'utf-8');

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();
}

const renderer = new marked.Renderer();
renderer.heading = function ({ text, depth }: { text: string; depth: number }) {
  const id = slugify(text);
  return `<h${depth} id="${id}">${text}</h${depth}>`;
};

marked.setOptions({ renderer, gfm: true, breaks: false });

const htmlContent = await marked.parse(markdown);

const schema = {
  '@type': 'WebPage',
  name: 'Terms of Use — Kiln',
  description:
    "The terms under which Kiln's open-source infrastructure is provided.",
  url: 'https://kiln3d.com/terms',
};
---

<BaseLayout
  title="Terms of Use — Kiln"
  description="Kiln's terms of use. Open-source infrastructure for controlling 3D printers — your responsibility to use it safely."
  current="terms"
  keywords={['kiln terms of use', 'kiln terms of service', '3d printing terms']}
  schema={schema}
>
  <main class="legal-page">
    <div class="page-hero">
      <div class="container-narrow">
        <h1>Terms of Use</h1>
        <p class="lead">The terms under which Kiln is provided.</p>
      </div>
    </div>
    <div class="container-narrow">
      <article class="prose" set:html={htmlContent} data-reveal />
    </div>
  </main>
</BaseLayout>

<style>
  .legal-page {
    padding-bottom: 128px;
  }

  .prose {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .prose :global(h1) {
    /* The first H1 comes from TERMS_OF_USE.md and duplicates the
       page hero above, so we hide it. */
    display: none;
  }

  .prose :global(h2) {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-top: 64px;
    margin-bottom: 16px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
    text-wrap: balance;
  }

  .prose :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .prose :global(h3) {
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-top: 40px;
    margin-bottom: 12px;
    padding-left: 14px;
    border-left: 2px solid var(--border-accent);
  }

  .prose :global(p) { margin-bottom: 16px; }
  .prose :global(strong) { font-weight: 600; color: var(--text); }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.18s var(--ease-swift);
  }
  .prose :global(a:hover) {
    color: var(--accent-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 16px;
    padding-left: 22px;
  }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(li::marker) { color: var(--text-subtle); }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong) 18%, var(--border-strong) 82%, transparent);
    margin: 56px 0;
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.875em;
    color: var(--text);
    background: var(--bg-code);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: calc(var(--radius-sm) - 2px);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 28px 0;
    font-size: 14px;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01)),
      var(--bg);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  .prose :global(th) {
    text-align: left;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-strong);
  }
  .prose :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .prose :global(tr:last-child td) { border-bottom: none; }

  .prose :global(blockquote) {
    border: 1px solid var(--border);
    border-left: 2px solid var(--border-accent);
    padding: 14px 20px;
    margin: 20px 0;
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-secondary);
  }
  .prose :global(blockquote p) { margin-bottom: 0; }

  .prose :global(em) {
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .legal-page { padding-bottom: 88px; }
    .prose :global(h2) { margin-top: 44px; padding-top: 28px; }
    .prose :global(h3) { margin-top: 28px; }
  }
</style>
