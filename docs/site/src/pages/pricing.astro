---
import BaseLayout from '../layouts/BaseLayout.astro';

// Pricing structure locked 2026-04-25 (war-room rounds 1-11):
//   Free       $0/mo            1 printer  · 1 seat   · non-commercial
//   Pro        $49/mo           1 printer  · 1 seat   · non-commercial (hobbyists)
//   Business   $199/mo          3 printers · 3 seats · commercial
//                                +$15/printer over 3 (cap 50)
//                                +$50/seat over 3 (cap 10)
//   Enterprise hidden            50 printers · flexible · custom
//                                Contact us — quoted per deal.
//
// Annual ~20% off for Pro and Business.  Enterprise is custom.

const pricingSchema = {
  '@type': 'OfferCatalog',
  name: 'Kiln Pricing Plans',
  itemListElement: [
    {
      '@type': 'Offer',
      name: 'Free',
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://kiln3d.com/pricing',
    },
    {
      '@type': 'Offer',
      name: 'Pro',
      price: '49',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://kiln3d.com/pricing',
    },
    {
      '@type': 'Offer',
      name: 'Business',
      price: '199',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://kiln3d.com/pricing',
    },
    // Enterprise omitted from schema — pricing is custom-quoted per
    // deal, not a public number.  Keeping it in the schema would
    // anchor every Google rich-result viewer to a specific dollar
    // figure that varies wildly by customer profile (compliance-grade
    // verticals vs SMB-leaning Enterprise).
  ],
};

const pricingFaqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is local printing really free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kiln is open source under AGPL-3.0 and local printing, slicing, and printer control are free forever.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I self-host everything?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kiln runs locally, and paid tiers add optional hosted features without removing local functionality.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need a paid plan for multiple printers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Free and Pro tiers each support 1 printer. Business includes 3 printers ($15/mo per additional, up to 50). For larger fleets, Enterprise is custom-quoted.',
      },
    },
    {
      '@type': 'Question',
      name: "What's included in Enterprise?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Enterprise is for teams running production print operations. It includes a dedicated single-tenant MCP server, SSO, role-based access control, full audit trails, lockable safety profiles, and a 99.9% uptime SLA. Pricing is custom — contact us for a quote that fits your team and use case.',
      },
    },
  ],
};
---

<BaseLayout
  title="Kiln Pricing — Plans for AI 3D Printing Infrastructure"
  description="Kiln pricing for AI 3D printing infrastructure. Local printing is free forever. Paid tiers add fleet management, hosted MCP, and enterprise controls."
  current="pricing"
  keywords={[
    'kiln pricing',
    '3d print farm pricing',
    'ai 3d printer infrastructure pricing',
    'mcp server pricing',
  ]}
  schema={[pricingSchema, pricingFaqSchema]}
>
  <section class="pricing-hero">
    <div class="container">
      <h1>Pricing</h1>
    </div>
  </section>

  <section class="pricing-cards">
    <div class="container-wide">
      <div class="billing-toggle">
        <span class="toggle-label" data-period="monthly">Monthly</span>
        <label class="toggle-switch">
          <input type="checkbox" id="billing-toggle" />
          <span class="toggle-slider"></span>
        </label>
        <span class="toggle-label" data-period="annual">Annual <span class="save-badge">Save 20%</span></span>
      </div>

      <div class="cards-grid">
        <!-- Free Tier -->
        <div class="card pricing-card">
          <div class="card-header">
            <h3>Free</h3>
            <p class="tier-tagline">For trying Kiln on your own printer.</p>
            <div class="price">
              <span class="amount">$0</span>
              <span class="period">/ forever</span>
            </div>
          </div>
          <ul class="features">
            <li><span class="check">&#10003;</span> Unlimited local printing</li>
            <li><span class="check">&#10003;</span> 1 printer</li>
            <li><span class="check">&#10003;</span> Personal / non-commercial use</li>
            <li><span class="check">&#10003;</span> 10-job queue</li>
            <li><span class="check">&#10003;</span> Design intelligence (25 FDM materials, 45 brand-specific filament profiles, 20 patterns)</li>
            <li><span class="check">&#10003;</span> Natural-language to physical fabrication &mdash; text/image to validated 3D print</li>
            <li><span class="check">&#10003;</span> Multi-modal decoration engine &mdash; 3/mo (QR, photos, text, SVG, brand assets)</li>
            <li><span class="check">&#10003;</span> Closed-loop AI generation feedback &mdash; failed prints auto-improve future generations</li>
            <li><span class="check">&#10003;</span> Printability engine (7-dimension analysis)</li>
            <li><span class="check">&#10003;</span> Multi-part assembly (up to 10 parts)</li>
            <li><span class="check">&#10003;</span> Cost estimation &amp; recommendations</li>
            <li><span class="check">&#10003;</span> 14-component parametric catalog</li>
            <li><span class="check">&#10003;</span> Local design history (linear) &mdash; branching, merge, and signed releases require Pro</li>
            <li><span class="check">&#10003;</span> 742 MCP tools &amp; 207 CLI commands</li>
            <li><span class="check">&#10003;</span> Community support</li>
            <li><span class="check">&#10003;</span> 3 fulfillment orders/month free</li>
            <li><span class="check">&#10003;</span> 5% orchestration fee on fulfillment</li>
          </ul>
          <a href="/install" class="btn card-cta">Let's build &#8594;</a>
          <p class="upgrade-note">Install with <code>pip install kiln3d</code></p>
        </div>

        <!-- Pro Tier -->
        <div class="card pricing-card">
          <div class="card-header">
            <h3>Pro</h3>
            <p class="tier-tagline">For hobbyists &amp; personal projects.</p>
            <div class="price">
              <span class="amount monthly-price">$49</span>
              <span class="amount annual-price" style="display:none">$39</span>
              <span class="period monthly-period">/ month</span>
              <span class="period annual-period" style="display:none">/ mo, billed annually</span>
            </div>
          </div>
          <ul class="features">
            <li><span class="check">&#10003;</span> Everything in Free</li>
            <li><span class="check">&#10003;</span> 1 printer (single-printer use)</li>
            <li><span class="check">&#10003;</span> Personal / non-commercial license</li>
            <li><span class="check">&#10003;</span> Unlimited job queue</li>
            <li><span class="check">&#10003;</span> Unlimited assembly parts</li>
            <li><span class="check">&#10003;</span> Git for 3D &mdash; branch, merge, cherry-pick, and Ed25519-sign releases for designs, decorations, and mechanical features</li>
            <li><span class="check">&#10003;</span> Ed25519-signed releases with tamper-evident fingerprint recompute &mdash; FDA 21 CFR 820.70 / AS9100 / ISO 13485 grade</li>
            <li><span class="check">&#10003;</span> Three-way semantic mesh merge &mdash; Z-level / pocket / bounding-box diff at manufacturing tolerance</li>
            <li><span class="check">&#10003;</span> Versioned decoration presets &mdash; brand-asset library with signed releases</li>
            <li><span class="check">&#10003;</span> Versioned mechanical features &mdash; chamfers, fillets, pockets, holes, bosses, ribs, screw-hole patterns, custom OpenSCAD</li>
            <li><span class="check">&#10003;</span> Solo cloud sync to Kiln Cloud &mdash; tenant-isolated RLS + Merkle push receipts</li>
            <li><span class="check">&#10003;</span> Product templates (coasters, keychains, ornaments, and more)</li>
            <li><span class="check">&#10003;</span> Procedural textures (tiger stripe, camo, marble, lava, wood, honeycomb)</li>
            <li><span class="check">&#10003;</span> Unlimited decorations &mdash; photo, text, SVG, brand assets <span class="feature-note">(QR codes are Business)</span></li>
            <li><span class="check">&#10003;</span> Mid-print modification engine &mdash; decorate, add features, swap material mid-job</li>
            <li><span class="check">&#10003;</span> Autonomous failure recovery &amp; print resume</li>
            <li><span class="check">&#10003;</span> Design provenance, regression detection, cross-branch outcome A/B</li>
            <li><span class="check">&#10003;</span> Manual speed control &amp; print learning</li>
            <li><span class="check">&#10003;</span> REST API server</li>
            <li><span class="check">&#10003;</span> Community support</li>
            <li><span class="check">&#10003;</span> 3 fulfillment orders/month free</li>
            <li><span class="check">&#10003;</span> 5% orchestration fee on fulfillment</li>
          </ul>
          <button type="button" class="btn card-cta checkout-cta" data-tier="pro">Get Pro &#8594;</button>
          <p class="upgrade-note">Already installed? Run <code>kiln license activate &lt;key&gt;</code></p>
        </div>

        <!-- Business Tier -->
        <div class="card pricing-card featured">
          <div class="badge">Recommended</div>
          <div class="card-header">
            <h3>Business</h3>
            <p class="tier-tagline">For anyone selling &mdash; Etsy, Shopify, custom orders, commercial work.</p>
            <div class="price">
              <span class="amount monthly-price">$199</span>
              <span class="amount annual-price" style="display:none">$159</span>
              <span class="period monthly-period">/ month</span>
              <span class="period annual-period" style="display:none">/ mo, billed annually</span>
            </div>
          </div>
          <ul class="features">
            <li><span class="check">&#10003;</span> Everything in Pro</li>
            <li><span class="check">&#10003;</span> Commercial license &mdash; sell what you make</li>
            <li><span class="check">&#10003;</span> 3 printers included <span class="feature-note">($15/mo each above, up to 50)</span></li>
            <li><span class="check">&#10003;</span> 3 team seats included <span class="feature-note">($50/mo each above, up to 10)</span></li>
            <li><span class="check">&#10003;</span> Multi-printer fleet management &amp; cross-printer learning</li>
            <li><span class="check">&#10003;</span> QR code generation</li>
            <li><span class="check">&#10003;</span> Layer-scheduled speed adjustments (auto-apply per-layer)</li>
            <li><span class="check">&#10003;</span> Team pull requests on design versions &mdash; code-review-style approval workflow with latest-decision-wins</li>
            <li><span class="check">&#10003;</span> Approval gates &mdash; required team reviewers, step-up authentication on production releases</li>
            <li><span class="check">&#10003;</span> Cross-organization artifact transfer &mdash; assign IP between orgs with audit trail</li>
            <li><span class="check">&#10003;</span> Federated design sharing &mdash; cross-operator cloud push/pull with SHA-256 branch anonymization</li>
            <li><span class="check">&#10003;</span> Unlimited fulfillment orders</li>
            <li><span class="check">&#10003;</span> Material compliance tracking</li>
            <li><span class="check">&#10003;</span> Priority support</li>
            <li><span class="check">&#10003;</span> Custom safety profiles</li>
            <li><span class="check">&#10003;</span> Webhook integrations</li>
          </ul>
          <button type="button" class="btn card-cta checkout-cta" data-tier="business">Get Business &#8594;</button>
          <p class="upgrade-note">Already installed? Run <code>kiln license activate &lt;key&gt;</code></p>
        </div>

        <!-- Enterprise Tier -->
        <div class="card pricing-card enterprise-card">
          <div class="card-header">
            <h3>Enterprise</h3>
            <p class="tier-tagline">Built for your team. Let's talk.</p>
            <div class="price">
              <span class="amount-text">Contact us</span>
            </div>
          </div>
          <ul class="features">
            <li><span class="check">&#10003;</span> Everything in Business</li>
            <li><span class="check">&#10003;</span> Unlimited team seats &amp; large fleets</li>
            <li><span class="check">&#10003;</span> SSO (SAML / OIDC) + SCIM provisioning</li>
            <li><span class="check">&#10003;</span> Role-based access control</li>
            <li><span class="check">&#10003;</span> Full audit trail with long-term retention</li>
            <li><span class="check">&#10003;</span> Lockable safety profiles</li>
            <li><span class="check">&#10003;</span> Encrypted G-code at rest</li>
            <li><span class="check">&#10003;</span> 99.9% uptime SLA</li>
            <li><span class="check">&#10003;</span> Dedicated CSM + sub-24h response SLA</li>
            <li><span class="check">&#10003;</span> On-prem / VPC deployment options</li>
            <li><span class="check">&#10003;</span> Custom integrations &amp; procurement terms</li>
          </ul>
          <a href="mailto:adam@kiln3d.com?subject=Kiln%20Enterprise%20enquiry" class="btn card-cta">Talk to us &#8594;</a>
          <p class="upgrade-note">Custom pricing tailored to your team, fleet, and compliance needs.</p>
        </div>
      </div>
      <p class="patent-footer">Patent-pending across Git-for-3D, mid-print modification, failure recovery, and AI generation feedback.</p>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details>
          <summary>Is local printing really free?</summary>
          <p>Yes. Kiln is open source (AGPL-3.0). Local printing, slicing, and printer control are free forever with no limits on print volume.</p>
        </details>
        <details>
          <summary>What is a fulfillment order?</summary>
          <p>When you outsource manufacturing through Craftcloud via Kiln. Local printing to your own printers does not count.</p>
        </details>
        <details>
          <summary>Can I self-host everything?</summary>
          <p>Yes. Kiln runs entirely locally. Pro/Business tiers add optional cloud features but local functionality never requires a subscription.</p>
        </details>
        <details>
          <summary>Do I need a paid plan for multiple printers?</summary>
          <p>Free and Pro tiers each support 1 printer. Business includes 3 printers ($15/mo per additional, up to 50). For larger fleets, Enterprise is custom-quoted.</p>
        </details>
        <details>
          <summary>What's the difference between Pro and Business?</summary>
          <p>Pro is licensed for personal and hobbyist use only — single user, single printer, no commercial selling. Business is for anyone running a real operation: Etsy shops, Shopify stores, custom-order businesses, agencies, schools, manufacturers. Business adds multi-printer fleet management, team seats, QR codes, commercial license, and the workflow features small shops actually need.</p>
        </details>
        <details>
          <summary>What does annual billing save?</summary>
          <p>Annual plans save roughly 20% compared to monthly. Pro drops from $49/mo to $39/mo ($468/yr). Business drops from $199/mo to $159/mo ($1,908/yr). Enterprise pricing is custom — annual savings are part of the conversation. You can switch between monthly and annual at any time.</p>
        </details>
        <details>
          <summary>What's included in Enterprise?</summary>
          <p>Enterprise is for teams running production print operations — manufacturing, regulated industries, large fleets. It includes a dedicated single-tenant MCP server, SSO, role-based access control, full audit trails, lockable safety profiles, on-prem or VPC deployment options, dedicated CSM, and a 99.9% uptime SLA. Pricing is tailored per deal — contact us for a quote that fits your team and use case.</p>
        </details>
        <details>
          <summary>Can I try Enterprise before committing?</summary>
          <p>Yes. Email <a href="mailto:adam@kiln3d.com?subject=Kiln%20Enterprise%20evaluation">adam@kiln3d.com</a> and we'll set you up with full Enterprise access to evaluate.</p>
        </details>
        <details>
          <summary>What about commercial licensing?</summary>
          <p>Kiln is open source under AGPL-3.0, which requires that derivative works and networked services built on Kiln also be open-sourced. If your company needs to use Kiln in proprietary products without AGPL obligations, we offer a commercial license. Contact <a href="mailto:adam@kiln3d.com?subject=Commercial%20License">adam@kiln3d.com</a> to discuss.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Commercial-use modal — fired before Pro checkout to gate
       commercial sellers into Business.  Defense-in-depth: the
       /api/billing/create-checkout-session endpoint also rejects
       Pro signups that declare commercial_use=true. -->
  <dialog id="commercial-use-modal" class="commercial-use-modal">
    <form method="dialog" class="commercial-use-content">
      <h3>Quick question before checkout</h3>
      <p>Will you be using Kiln for products you sell or commercial work?</p>
      <div class="commercial-use-buttons">
        <button type="submit" value="yes" class="btn commercial-use-yes">
          Yes — I sell or do commercial work
        </button>
        <button type="submit" value="no" class="btn commercial-use-no">
          No — just personal projects
        </button>
      </div>
      <p class="commercial-use-note">
        Pro is licensed for personal &amp; hobbyist use only. Commercial sellers (Etsy, Shopify, custom orders, agencies) need Business.
      </p>
    </form>
  </dialog>
</BaseLayout>

<script>
  const toggle = document.getElementById('billing-toggle') as HTMLInputElement | null;
  if (toggle) {
    toggle.addEventListener('change', () => {
      const isAnnual = toggle.checked;
      document.querySelectorAll('.monthly-price, .monthly-period, .monthly-price-period').forEach(el => {
        (el as HTMLElement).style.display = isAnnual ? 'none' : '';
      });
      document.querySelectorAll('.annual-price, .annual-period, .annual-price-period').forEach(el => {
        (el as HTMLElement).style.display = isAnnual ? '' : 'none';
      });
    });
  }

  // Stripe Checkout CTAs — POST to the kiln-pro REST API, redirect to
  // the returned Stripe-hosted checkout URL.  The API root is resolved
  // from PUBLIC_KILN_API_URL at build time; falls back to the production
  // deployment so the static site works locally-built too.
  const API_ROOT =
    (import.meta as any).env?.PUBLIC_KILN_API_URL ||
    'https://api.kiln3d.com';

  async function startCheckout(
    tier: string,
    billing: 'monthly' | 'annual',
    btn: HTMLButtonElement,
    extraBody: Record<string, unknown> = {},
  ) {
    const originalLabel = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Redirecting to Stripe…';
    try {
      const resp = await fetch(`${API_ROOT}/api/billing/create-checkout-session`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tier,
          billing,
          success_url: `${window.location.origin}/checkout/success?session_id={CHECKOUT_SESSION_ID}`,
          cancel_url: `${window.location.origin}/pricing`,
          ...extraBody,
        }),
      });
      const data = await resp.json();
      if (!resp.ok || !data.success || !data.checkout_url) {
        // If the API redirects us to a different tier (Pro→Business
        // when commercial_use=true sneaks through), surface a clear
        // message rather than a generic error.
        if (data.upgrade_to) {
          alert(
            `Pro is licensed for personal use only.\n\n` +
            `Click "Get Business" instead — that's the right plan for commercial work.`,
          );
          btn.disabled = false;
          btn.textContent = originalLabel;
          return;
        }
        throw new Error(data.error || `Checkout failed (${resp.status})`);
      }
      window.location.href = data.checkout_url;
    } catch (err: any) {
      btn.disabled = false;
      btn.textContent = originalLabel;
      console.error('Checkout error:', err);
      alert(
        `Couldn't start checkout: ${err?.message ?? 'unknown error'}\n\n` +
        `If this keeps happening, email adam@kiln3d.com and we'll set you up manually.`,
      );
    }
  }

  function pickBusinessButton(): HTMLButtonElement | null {
    return document.querySelector<HTMLButtonElement>(
      '.checkout-cta[data-tier="business"]',
    );
  }

  document.querySelectorAll<HTMLButtonElement>('.checkout-cta').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tier = btn.dataset.tier;
      if (!tier) return;
      const billing: 'monthly' | 'annual' = toggle?.checked ? 'annual' : 'monthly';

      // Pro CTA → first ask the commercial-use question.  If the
      // buyer answers "yes", route to the Business CTA instead.  If
      // they answer "no", continue with Pro.  The modal closes
      // returning '' if dismissed without choosing — abort silently.
      if (tier === 'pro') {
        const modal = document.getElementById(
          'commercial-use-modal',
        ) as HTMLDialogElement | null;
        if (modal) {
          modal.showModal();
          const answer = await new Promise<string>(resolve => {
            modal.addEventListener(
              'close',
              () => resolve(modal.returnValue),
              { once: true },
            );
          });
          if (answer === 'yes') {
            const businessBtn = pickBusinessButton();
            if (businessBtn) {
              businessBtn.click();
            } else {
              await startCheckout('business', billing, btn);
            }
            return;
          }
          if (answer !== 'no') {
            // User dismissed without choosing — abort.
            return;
          }
          // answer === 'no' → fall through to Pro checkout, with the
          // commercial_use=false flag passed through to Stripe metadata
          // so the audit trail captures the explicit declaration.
          await startCheckout('pro', billing, btn, {
            commercial_use: false,
          });
          return;
        }
      }

      await startCheckout(tier, billing, btn);
    });
  });
</script>

<style>
  .pricing-hero {
    text-align: center;
    padding: 100px 0 40px;
  }
  .pricing-hero h1 {
    font-size: 40px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .pricing-hero .lead {
    color: var(--text-muted);
    font-size: 17px;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Billing toggle */
  .billing-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
  }
  .toggle-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .save-badge {
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }
  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--border);
    border-radius: 24px;
    transition: 0.2s;
  }
  .toggle-slider::before {
    content: '';
    position: absolute;
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background: #fff;
    border-radius: 50%;
    transition: 0.2s;
  }
  .toggle-switch input:checked + .toggle-slider {
    background: var(--accent);
  }
  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(20px);
  }

  /* Cards grid */
  .pricing-cards {
    padding: 20px 0 80px;
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  /* Card */
  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
  }
  .pricing-card .card-header {
    margin-bottom: 24px;
  }
  .pricing-card h3 {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text);
  }
  .tier-tagline {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 12px;
    line-height: 1.5;
    min-height: 36px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .price .amount {
    font-size: 40px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }
  .price .amount-text {
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
    line-height: 1;
  }
  .price .period {
    font-size: 14px;
    color: var(--text-muted);
  }
  .price-note {
