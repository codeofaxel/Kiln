---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Integration {
  name: string;
  title: string;
  description: string;
  icon: string;
  tag: string;
}

const printerIntegrations: Integration[] = [
  {
    name: 'octoprint',
    title: 'OctoPrint',
    description:
      'Connect any OctoPrint-powered printer to Kiln so AI agents can run monitored prints, queue jobs, and enforce safety checks through one interface.',
    icon: '🐙',
    tag: 'REST API',
  },
  {
    name: 'moonraker',
    title: 'Moonraker / Klipper',
    description:
      'Use Kiln with any Moonraker/Klipper printer — Voron, Rat Rig V-Core 3, Sovol SV07, QIDI X-Plus 3, and more — for high-speed workflows, fleet routing, and JSON-first automation in CLI or MCP.',
    icon: '🌙',
    tag: 'REST API',
  },
  {
    name: 'creality',
    title: 'Creality',
    description:
      'Connect Creality K1, K2, Hi, Ender V3 KE, and similar CrealityOS printers through local Moonraker when reachable on the LAN. Older Marlin Creality machines still work through OctoPrint or Direct USB.',
    icon: '🟩',
    tag: 'Moonraker',
  },
  {
    name: 'bambu',
    title: 'Bambu Lab',
    description:
      'Bring Bambu Lab printers — X1C, X1E, P1S, P1P, P2S, A1, A1 Mini, A2L, and the enclosed H2S — into an AI-native workflow with controlled commands, telemetry, and queue orchestration.',
    icon: '🟦',
    tag: 'MQTT',
  },
  {
    name: 'prusa',
    title: 'Prusa Link',
    description:
      'Run Prusa printers through a consistent API so agents can monitor status, launch prints, and manage multi-printer jobs without custom glue code.',
    icon: '🟧',
    tag: 'REST API',
  },
  {
    name: 'elegoo',
    title: 'Elegoo',
    description:
      'Give AI agents access to Elegoo printers with standardized command handling, safety profiles, and remote monitoring inside the Kiln control plane.',
    icon: '⬛',
    tag: 'REST API',
  },
  {
    name: 'usb',
    title: 'Direct USB',
    description:
      'Connect any Marlin-based printer over USB — no OctoPrint or Klipper needed. Plug in a cable and go. Works with Ender 3, Prusa MK3, CR-10, and any printer running Marlin or RepRapFirmware.',
    icon: '🔌',
    tag: 'USB',
  },
];

const ecosystemIntegrations: Integration[] = [
  {
    name: 'craftcloud',
    title: 'Craftcloud',
    description:
      'Get quotes and place outsourced 3D print orders across 150+ providers when local printers are busy, offline, or unavailable.',
    icon: '☁️',
    tag: 'Fulfillment',
  },
  {
    name: 'marketplaces',
    title: 'Search 3rd-Party Marketplaces',
    description:
      'Search and download 3D models from MyMiniFactory (works out of the box) and Cults3D (search only, requires your own API key). Find existing blueprints before generating from scratch.',
    icon: '🔍',
    tag: 'Discovery',
  },
  {
    name: 'slicing',
    title: 'PrusaSlicer & OrcaSlicer',
    description:
      'Auto-detect installed slicers. Slice STL files with bundled printer profiles, adaptive layer heights, and material-aware settings. Go from model to G-code in one call.',
    icon: '✂️',
    tag: 'Slicing',
  },
  {
    name: 'mcp',
    title: 'Model Context Protocol',
    description:
      'Expose Kiln as an MCP server so Claude, GPT, and other AI agents can use 828 MCP tools safely with structured, typed responses.',
    icon: '🤖',
    tag: 'AI Protocol',
  },
  {
    name: 'generation',
    title: 'Text & Sketch to 3D',
    description:
      'Generate printable models from text or sketches via Gemini Deep Think, Meshy, Tripo3D, Stability AI, or parametric OpenSCAD. Auto-discovered from env vars.',
    icon: '✨',
    tag: 'Generation',
  },
  {
    name: 'webhooks',
    title: 'Webhooks & Event Bus',
    description:
      'Register HTTP endpoints for instant notifications when jobs complete, fail, or change state. HMAC-SHA256 signed payloads for secure integration.',
    icon: '🔔',
    tag: 'Events',
  },
];

const integrationSchema = {
  '@type': 'ItemList',
  name: 'Kiln Integrations',
  itemListElement: [...printerIntegrations, ...ecosystemIntegrations].map(
    (integration, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: integration.title,
      description: integration.description,
    }),
  ),
};
---

<BaseLayout
  title="Kiln Integrations — OctoPrint, Moonraker, Creality, Bambu, Prusa, Elegoo, MCP"
  description="Kiln integrations for OctoPrint, Moonraker, Creality, Bambu Lab, Prusa Link, Elegoo, MCP clients, fulfillment, and model marketplaces."
  current="integrations"
  keywords={[
    'kiln integrations',
    'octoprint ai tools',
    'moonraker mcp integration',
    'creality k1 max ai tools',
    'bambu lab ai tools',
    'prusa link ai tools',
    'ai tools for 3d printer control',
  ]}
  schema={integrationSchema}
>
  <div class="page-hero">
    <div class="container">
      <h1>Kiln integrations for the full 3D printing stack</h1>
      <p class="lead">
        Kiln connects AI agents to printers, slicers, fulfillment providers, and model marketplaces.
        One control plane, consistent safety model, and shared agent workflow.
      </p>
      <div class="stat-row">
        <div class="stat">
          <span class="stat-num">7</span>
          <span class="stat-label">Printer backends</span>
        </div>
        <div class="stat">
          <span class="stat-num">150+</span>
          <span class="stat-label">Fulfillment providers</span>
        </div>
        <div class="stat">
          <span class="stat-num">2</span>
          <span class="stat-label">3rd-party marketplaces</span>
        </div>
        <div class="stat">
          <span class="stat-num">789</span>
          <span class="stat-label">MCP tools</span>
        </div>
      </div>
    </div>
  </div>

  <section class="integrations-section bordered">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow">Printer backends</span>
        <h2>Works with your existing printers</h2>
        <p class="lead">Use Kiln as a universal interface for mixed-brand 3D printer fleets — with tuned profiles for <a href="/printers">dozens of specific models</a>.</p>
      </div>
      <div class="printer-grid">
        {printerIntegrations.map((integration, i) => (
          <article
            class="card integration-card"
            id={integration.name}
            data-reveal
            style={`--reveal-delay: ${Math.min(i * 0.06, 0.4)}s`}
          >
            <div class="card-top">
              <span class="card-icon">{integration.icon}</span>
              <span class="card-tag">{integration.tag}</span>
            </div>
            <h3>{integration.title}</h3>
            <p>{integration.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="integrations-section bordered">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow">Ecosystem</span>
        <h2>Fulfillment, discovery, and AI interop</h2>
        <p class="lead">Route to 3rd-party fulfillment providers, search existing marketplaces, generate models, and plug into AI agents.</p>
      </div>
      <div class="ecosystem-grid">
        {ecosystemIntegrations.map((integration, i) => (
          <article
            class="card integration-card"
            id={integration.name}
            data-reveal
            style={`--reveal-delay: ${Math.min(i * 0.06, 0.4)}s`}
          >
            <div class="card-top">
              <span class="card-icon">{integration.icon}</span>
              <span class="card-tag">{integration.tag}</span>
            </div>
            <h3>{integration.title}</h3>
            <p>{integration.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="integrations-cta bordered">
    <div class="container">
      <div data-reveal>
        <h2>Start integrating in minutes</h2>
        <p class="lead">
          Install Kiln, connect your printer backend, and expose tools to your AI agent through MCP or the CLI.
        </p>
        <div class="cta-actions">
          <a href="/install" class="btn">Install Kiln</a>
          <a href="/docs" class="btn btn-ghost">Read Docs</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero stat row — machined figures under the lead */
  .stat-row {
    display: flex;
    justify-content: center;
    gap: clamp(32px, 6vw, 72px);
    flex-wrap: wrap;
    margin-top: 56px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .stat-num {
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Left-aligned section head: eyebrow + h2 + lead (globals do the type) */
  .section-header {
    max-width: 720px;
  }

  /* Printer grid: 3-up, collapsing by available width */
  .printer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  /* Ecosystem grid: 2×3 */
  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* Cards — glass surface from the .card primitive; these are anchor
     targets, not links, so no hover lift. */
  .integration-card {
    height: 100%;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    font-size: 20px;
    line-height: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .card-tag {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--text-muted);
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 10px;
  }

  .integration-card h3 {
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .integration-card p {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
  }

  /* CTA */
  .integrations-cta {
    text-align: center;
  }

  .integrations-cta .lead {
    margin: 0 auto 36px;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cta-actions .btn-ghost {
    margin-left: 0;
  }

  @media (max-width: 720px) {
    .ecosystem-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .stat-row {
      margin-top: 40px;
      gap: 28px 36px;
    }
  }
</style>
