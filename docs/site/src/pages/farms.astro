---
import BaseLayout from '../layouts/BaseLayout.astro';

interface ProofPoint {
  value: string;
  label: string;
}

interface Backend {
  name: string;
  protocol: string;
  note: string;
}

interface Capability {
  eyebrow: string;
  title: string;
  body: string;
}

interface BoundaryItem {
  label: string;
  body: string;
}

interface ShopType {
  title: string;
  body: string;
}

const proofPoints: ProofPoint[] = [
  { value: '7', label: 'printer backends' },
  { value: 'MCP', label: 'agent-native control' },
  { value: 'LAN', label: 'local-first operation' },
  { value: 'CI', label: 'fleet checks ready' },
];

const backends: Backend[] = [
  {
    name: 'Bambu Lab',
    protocol: 'MQTT + local network',
    note: 'A1, A2, P1, P2, X1, and H2 families through the dedicated Bambu adapter.',
  },
  {
    name: 'Creality',
    protocol: 'Moonraker / Klipper',
    note: 'K1, K2, Hi, Ender V3 KE, and CrealityOS machines when local Moonraker is reachable.',
  },
  {
    name: 'Prusa Link',
    protocol: 'REST',
    note: 'Prusa printers through Prusa Link with adapter-level safety handling.',
  },
  {
    name: 'Elegoo',
    protocol: 'SDCP WebSocket',
    note: 'Supported Elegoo SDCP/WebSocket printers such as Centauri Carbon; Neptune printers use Moonraker when exposed.',
  },
  {
    name: 'OctoPrint',
    protocol: 'REST',
    note: 'A stable path for many older, modified, and farm-managed printers.',
  },
  {
    name: 'Moonraker / Klipper',
    protocol: 'HTTP / WebSocket',
    note: 'Generic Klipper-class machines when their Moonraker API is reachable on the local network — Voron, RatRig, Sovol, and other Klipper builds.',
  },
  {
    name: 'Direct USB',
    protocol: 'USB serial',
    note: 'Marlin and RepRapFirmware printers when a direct cable is the right control path.',
  },
];

const capabilities: Capability[] = [
  {
    eyebrow: '01',
    title: 'One control contract for the room',
    body: 'Agents using Kiln\'s MCP server, plus CLI and CI workflows, can inspect printer state, temperatures, files, jobs, materials, and snapshots instead of hopping between vendor tools.',
  },
  {
    eyebrow: '02',
    title: 'Safety before motion',
    body: 'Starts route through preview confirmation, printer profiles, bed-fit checks, material guidance, and adapter-aware upload flows. Kiln gives agents a responsible path to physical hardware.',
  },
  {
    eyebrow: '03',
    title: 'Real mixed-fleet coverage',
    body: 'Bambu Lab, Creality, Prusa Link, Elegoo, OctoPrint, Moonraker/Klipper, and direct USB can live behind the same local control layer.',
  },
  {
    eyebrow: '04',
    title: 'Automation without moving private code',
    body: 'Public Kiln exposes the local MCP and CLI contract. Business and Enterprise workflows can stay in private infrastructure without shipping private code.',
  },
];

const publicLayer: BoundaryItem[] = [
  {
    label: 'Local printer adapters',
    body: 'Connect and normalize supported printer backends on the same LAN or USB host.',
  },
  {
    label: 'MCP and CLI tools',
    body: 'Expose printer operations, validation, slicing, monitoring, and model workflows to agents and scripts.',
  },
  {
    label: 'Safety profiles',
    body: 'Keep printer-specific dimensions, temperature limits, material guidance, camera support, and multicolor capabilities close to the adapter layer.',
  },
];

const proLayer: BoundaryItem[] = [
  {
    label: 'Hosted account workflows',
    body: 'Keep account-aware execution outside the public package when teams need Business or Enterprise controls.',
  },
  {
    label: 'Fleet and recovery workflows',
    body: 'Business and Enterprise routing, recovery, and team operations live privately in kiln-pro. Pro is for a single printer.',
  },
  {
    label: 'Commercial controls',
    body: 'The public package can discover and proxy eligible pro tools without moving proprietary implementations into the public repo.',
  },
];

const shopTypes: ShopType[] = [
  {
    title: 'Custom merch and short-run production',
    body: 'Repeated designs, mixed materials, and tight turnaround need printer status that an agent can trust before every job.',
  },
  {
    title: 'Prototype and product teams',
    body: 'Different printer types can share one validation and launch path while engineering keeps control over approved profiles.',
  },
  {
    title: 'Education and research labs',
    body: 'Shared fabrication rooms get a local MCP and CI command path that staff can document once and agents can respect every time.',
  },
  {
    title: 'In-house manufacturing',
    body: 'Jigs, fixtures, replacement parts, and low-volume production benefit from predictable setup across brands and teams.',
  },
];

const farmsSchema = {
  '@type': 'Product',
  name: 'Kiln for Print Farms',
  description:
    '3D printing infrastructure for AI agents and CI workflows running mixed local printer fleets.',
  brand: { '@type': 'Brand', name: 'Kiln' },
};
---

<BaseLayout
  title="Kiln for Print Farms - AI Printer Control for Mixed Fleets"
  description="3D printing infrastructure for AI agents and CI workflows running mixed local printer fleets across Bambu Lab, Creality, Prusa Link, Elegoo, OctoPrint, Moonraker/Klipper, and direct USB."
  current="farms"
  keywords={[
    'print farm infrastructure',
    '3d print farm management',
    'multi printer control',
    'ai print farm',
    'bambu fleet management',
    'creality print farm',
    'octoprint alternative',
    'moonraker printer management',
    'local 3d printer control',
  ]}
  schema={farmsSchema}
>
  <section class="page-hero farm-hero">
    <div class="hero-scene" aria-hidden="true">
      <div class="control-map">
        <div class="map-clients">
          <span>Claude</span>
          <span>Codex</span>
          <span>Custom MCP clients</span>
        </div>
        <div class="map-interfaces">
          <span>Kiln MCP server</span>
          <span>Kiln CLI</span>
        </div>
        <div class="map-core">
          <p>local host</p>
          <strong>Kiln</strong>
          <span>validation + safety gates</span>
        </div>
        <div class="adapter-track">
          <span>OctoPrint</span>
          <span>Moonraker</span>
          <span>Creality</span>
          <span>Bambu</span>
          <span>Prusa Link</span>
          <span>Elegoo</span>
          <span>Direct USB</span>
        </div>
        <div class="endpoint-track">
          <span>K1 Max</span>
          <span>Bambu A1</span>
          <span>MK4</span>
          <span>Centauri</span>
          <span>Neptune 4</span>
          <span>Ender 3 USB</span>
        </div>
      </div>
    </div>

    <div class="container hero-copy">
      <p class="eyebrow">Kiln for print farms</p>
      <h1>The control layer for AI-ready <span class="serif-accent">printer rooms</span>.</h1>
      <p class="lead">
        Kiln gives agents using MCP, plus CLI and CI workflows, one safe local
        control path for
        mixed printer fleets: discover, validate, slice, upload, start,
        monitor, recover, and stop jobs through adapter-aware guardrails.
      </p>
      <div class="cta-actions">
        <a href="/install" class="btn">Install Kiln</a>
        <a href="/pricing" class="btn btn-ghost">See Business options</a>
      </div>
      <div class="proof-strip" aria-label="Kiln print farm proof points">
        {proofPoints.map((point) => (
          <div class="proof-item">
            <strong>{point.value}</strong>
            <span>{point.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="farm-thesis bordered">
    <div class="container">
      <div class="thesis-grid">
        <div data-reveal>
          <p class="eyebrow">The actual farm problem</p>
          <h2>More printers usually means more control surfaces.</h2>
        </div>
        <p data-reveal style="--reveal-delay: 0.08s">
          A serious print room rarely standardizes forever. One team adds a
          Bambu Lab printer for speed, a Creality machine for large-format
          throughput, a Prusa for reliability, a Klipper machine for tuning,
          and an OctoPrint box for the older workhorse. Kiln turns that pile
          of interfaces into one local printer-control layer an agent can
          reason about.
        </p>
      </div>
    </div>
  </section>

  <section class="farm-capabilities bordered">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Operating model</p>
        <h2>Built around the room, not one brand.</h2>
      </div>
      <div class="capability-grid">
        {capabilities.map((capability, index) => (
          <article
            class="card capability-card"
            data-reveal
            style={`--reveal-delay: ${(index * 0.07).toFixed(2)}s`}
          >
            <span>{capability.eyebrow}</span>
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="backend-section bordered">
    <div class="container">
      <div class="split-head" data-reveal>
        <div>
          <p class="eyebrow">Printer coverage</p>
          <h2>Farm-ready because the adapters are real.</h2>
        </div>
        <p>
          Kiln does not need every printer to speak the same protocol. It needs
          each adapter to expose the same safe operations to the agent. Tuned
          per-model profiles cover dozens of models across a dozen brands
          &mdash; the <a href="/printers">supported printers list</a> has
          every one.
        </p>
      </div>
      <div class="card backend-list" data-reveal style="--reveal-delay: 0.08s">
        {backends.map((backend) => (
          <article class="backend-row">
            <div>
              <h3>{backend.name}</h3>
              <span>{backend.protocol}</span>
            </div>
            <p>{backend.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="boundary-section bordered">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Clean public/private boundary</p>
        <h2>Open infrastructure below. Business and Enterprise fleets above.</h2>
        <p class="lead">
          This is the line that lets the public package stay useful while
          Business and Enterprise workflows remain protected.
        </p>
      </div>
      <p class="tier-note" data-reveal style="--reveal-delay: 0.06s">
        Pro is intentionally limited to one printer. Fleet features belong to
        Business and Enterprise.
      </p>
      <div class="boundary-grid">
        <article class="card boundary-column" data-reveal>
          <div class="column-kicker">Public Kiln</div>
          {publicLayer.map((item) => (
            <div class="boundary-item">
              <h3>{item.label}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </article>
        <article class="card boundary-column pro" data-reveal style="--reveal-delay: 0.08s">
          <div class="column-kicker">Business and Enterprise layer</div>
          {proLayer.map((item) => (
            <div class="boundary-item">
              <h3>{item.label}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </article>
      </div>
    </div>
  </section>

  <section class="shop-section bordered">
    <div class="container">
      <div class="split-head" data-reveal>
        <div>
          <p class="eyebrow">Who this is for</p>
          <h2>Rooms where print failure has a real cost.</h2>
        </div>
        <p>
          Kiln is useful for a hobby bench. This page is for rooms where
          printers are production equipment, and the team needs an MCP and CI
          path that keeps up with the room.
        </p>
      </div>
      <div class="shop-grid">
        {shopTypes.map((shop, index) => (
          <article
            class="card shop-card"
            data-reveal
            style={`--reveal-delay: ${(index * 0.07).toFixed(2)}s`}
          >
            <h3>{shop.title}</h3>
            <p>{shop.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="farm-cta bordered">
    <div class="container" data-reveal>
      <p class="eyebrow">Start local, scale cleanly</p>
      <h2>Give every agent the same printer surface.</h2>
      <p class="lead">
        Install Kiln, connect the printers already in the room, and make the
        local control layer solid before layering on Business workflows.
      </p>
      <div class="cta-actions">
        <a href="/install" class="btn">Install Kiln</a>
        <a href="/integrations" class="btn btn-ghost">Check integrations</a>
        <a href="/pricing" class="btn btn-ghost">Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------------
     Hero — the page-hero voice with the control-map diagram above the copy.
     The map flows top-down: agent clients → Kiln interfaces → the local
     Kiln core → adapters → machines.  Pure decoration (aria-hidden), laid
     out in normal flow so it wraps instead of colliding at narrow widths.
     ------------------------------------------------------------------------ */
  .page-hero.farm-hero {
    padding: 56px 0 88px;
  }

  .hero-scene {
    position: relative;
    max-width: 1040px;
    margin: 0 auto 64px;
    padding: 36px 20px 10px;
  }

  /* Machined grid behind the diagram, fading out radially at the edges. */
  .hero-scene::before {
    content: '';
    position: absolute;
    inset: -24px 0;
    background:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 54px 54px;
    opacity: 0.55;
    mask-image: radial-gradient(80% 100% at 50% 42%, #000 32%, transparent 78%);
    -webkit-mask-image: radial-gradient(80% 100% at 50% 42%, #000 32%, transparent 78%);
  }

  .control-map {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .map-clients,
  .map-interfaces,
  .adapter-track,
  .endpoint-track {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .adapter-track { max-width: 720px; }
  .endpoint-track { max-width: 820px; }

  .map-clients span,
  .map-interfaces span,
  .adapter-track span,
  .endpoint-track span {
    background: color-mix(in srgb, var(--bg-elevated) 78%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-secondary);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 7px 11px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Kiln's own surfaces carry the ember; everything else stays neutral. */
  .map-interfaces span {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border-color: var(--border-accent);
    color: var(--accent-bright);
  }

  .endpoint-track span {
    border-color: var(--border);
    color: var(--text-muted);
  }

  .map-core {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 4px;
    width: 118px;
    height: 118px;
    margin: 30px 0;
    padding: 0 14px;
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 0%, var(--accent-glow), transparent 58%),
      var(--bg-elevated);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.5),
      0 0 90px var(--accent-glow);
  }

  /* Connector stems above and below the core node. */
  .map-core::before,
  .map-core::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 28px;
  }

  .map-core::before {
    bottom: 100%;
    background: linear-gradient(180deg, transparent, var(--border-accent));
  }

  .map-core::after {
    top: 100%;
    background: linear-gradient(180deg, var(--border-accent), transparent);
  }

  .map-core p,
  .map-core span {
    margin: 0;
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.07em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }

  .map-core strong {
    color: var(--text);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .page-hero.farm-hero h1 {
    max-width: 21ch;
    margin-inline: auto;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 36px;
  }

  .cta-actions .btn-ghost {
    margin-left: 0;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    margin: 56px auto 0;
    max-width: 820px;
  }

  .proof-item {
    border-right: 1px solid var(--border);
    padding: 20px 16px 0;
  }

  .proof-item:last-child {
    border-right: none;
  }

  .proof-item strong {
    display: block;
    color: var(--text);
    font-family: var(--mono);
    font-size: 24px;
    line-height: 1;
    margin-bottom: 8px;
  }

  .proof-item span {
    color: var(--text-muted);
    font-size: 13px;
    letter-spacing: 0.01em;
  }

  /* ------------------------------------------------------------------------
     Section heads — centered .section-head comes from the system; split-head
     is the left-aligned variant: eyebrow + h2 on the left, supporting copy
     on the right.
     ------------------------------------------------------------------------ */
  .thesis-grid,
  .split-head {
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .split-head {
    margin-bottom: 56px;
  }

  .thesis-grid h2,
  .split-head h2 {
    margin-bottom: 0;
  }

  .thesis-grid > p {
    color: var(--text-secondary);
    font-size: var(--text-lead);
    line-height: 1.65;
    margin: 0;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .split-head > p {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    max-width: 54ch;
    text-wrap: pretty;
  }

  /* ------------------------------------------------------------------------
     Glass cards + table rows
     ------------------------------------------------------------------------ */
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .capability-card > span {
    display: block;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    margin-bottom: 20px;
  }

  .capability-card h3,
  .shop-card h3,
  .backend-row h3,
  .boundary-item h3 {
    color: var(--text);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  .capability-card p,
  .shop-card p,
  .backend-row p,
  .boundary-item p {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.65;
    margin: 0;
    text-wrap: pretty;
  }

  /* Backend coverage as one glass table: hairline-divided rows. */
  .backend-list {
    padding: 0;
    overflow: hidden;
  }

  .backend-row {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 28px;
    padding: 24px 28px;
  }

  .backend-row + .backend-row {
    border-top: 1px solid var(--border);
  }

  .backend-row h3 {
    margin-bottom: 6px;
  }

  .backend-row span {
    display: block;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  /* ------------------------------------------------------------------------
     Public / private boundary columns
     ------------------------------------------------------------------------ */
  .tier-note {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.6;
    margin: -28px auto 48px;
    max-width: 56ch;
    text-align: center;
  }

  .boundary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }

  .boundary-column {
    padding: 30px;
  }

  .boundary-column.pro {
    border-color: var(--border-accent);
    background:
      radial-gradient(120% 70% at 50% -8%, var(--accent-glow), transparent 60%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      var(--bg);
  }

  .column-kicker {
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    margin-bottom: 24px;
    padding-bottom: 16px;
    text-transform: uppercase;
  }

  .boundary-column.pro .column-kicker {
    border-bottom-color: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--accent-bright);
  }

  .boundary-item + .boundary-item {
    border-top: 1px solid var(--border);
    margin-top: 22px;
    padding-top: 22px;
  }

  /* ------------------------------------------------------------------------
     Shop types + closing CTA
     ------------------------------------------------------------------------ */
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .farm-cta {
    text-align: center;
  }

  .farm-cta .lead {
    margin: 0 auto 8px;
    max-width: 600px;
  }

  /* ------------------------------------------------------------------------
     Responsive
     ------------------------------------------------------------------------ */
  @media (max-width: 900px) {
    .thesis-grid,
    .split-head,
    .boundary-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }

    .shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .backend-row {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 22px 24px;
    }

    .proof-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proof-item {
      padding: 18px 16px;
    }

    .proof-item:nth-child(even) {
      border-right: none;
    }

    .proof-item:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .page-hero.farm-hero {
      padding: 36px 0 56px;
    }

    .hero-scene {
      margin-bottom: 44px;
      padding-top: 28px;
    }

    /* Trim the decorative tracks so the diagram stays calm on small screens. */
    .adapter-track span:nth-child(n + 6),
    .endpoint-track span:nth-child(n + 5) {
      display: none;
    }

    .map-core {
      width: 108px;
      height: 108px;
      margin: 24px 0;
    }

    .map-core strong {
      font-size: 20px;
    }

    .proof-strip {
      margin-top: 44px;
    }

    .split-head {
      margin-bottom: 44px;
    }

    .tier-note {
      margin: -12px auto 40px;
    }

    .shop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
