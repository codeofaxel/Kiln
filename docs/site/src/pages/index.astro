---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GitForThreeDHighlight from '../components/GitForThreeDHighlight.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Steps from '../components/Steps.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CTA from '../components/CTA.astro';

---

<BaseLayout
  title="Kiln 3D — Connect AI Agents to 3D Printers | OctoPrint, Creality, Bambu"
  description="Kiln 3D is open-source infrastructure that lets AI agents design objects, discover models, and safely operate OctoPrint, Moonraker, Creality, Bambu Lab, Elegoo, and Prusa printers through one MCP server and CLI."
  keywords={[
    'ai agent tools for 3d printers',
    'connect ai to 3d printer',
    'open source 3d printer tools',
    '3d printer tools for ai agents',
    'use ai with 3d printer',
    'mcp server 3d printing',
  ]}
>
  <Hero />

  <!--
    Receipts — promoted to the second screen on 2026-04-25.  The
    two existing object photos already carry the page's two
    strongest promises (one thing
    today / a hundred this week / your factory at home / your
    startup's merch from your bedroom).  Hiding them in section 9
    meant 80% of visitors decided to stay or leave before they
    ever saw the proof.  Promoting the section + re-captioning to
    name the buyer + the time turns the same two assets into the
    page's whole sales pitch on the second scroll.

    Heading is the single load-bearing sentence on the page after
    the hero: "One thing today. Or a hundred this week." — both of
    Adam's bullets in nine words.  Sub-line "Same printer. Same
    desk. One prompt each." carries the at-home / your-own-factory
    half so neither promise has to wait for the captions.

    Captions retain yesterday's italic-quote pattern (the strongest
    typography on the page) and add a time + buyer beat to the
    meta line so each photo proves a different door.

    Earlier shape (centered "A few words. A picture you already
    had. A real object in your hand." with two anonymous coasters
    and the run video) is preserved in git history at
    HEAD~ on 2026-04-24 if a rollback is ever needed.
  -->
  <section id="demo" class="receipts bordered">
    <div class="container">
      <h2 class="receipts-heading" data-reveal>One thing today. Or a hundred this week.</h2>
      <p class="receipts-sub" data-reveal style="--reveal-delay: 0.08s">Same printer. Same desk. One prompt each.</p>

      <div class="receipts-grid">
        <!-- Door 1: one thing, today.  Ash coaster — the
             personal-prototype-by-dinner promise. -->
        <figure class="receipt" data-reveal>
          <div class="receipt-img-wrap">
            <img
              src="/demo/ash-coaster.jpg"
              alt="A white 3D-printed round coaster showing a relief portrait of a French bulldog and the name ASH along the bottom edge, held in a hand"
              loading="lazy"
              width="1200"
              height="1600"
            />
          </div>
          <figcaption class="receipt-caption">
            <p class="receipt-kicker">One thing, today</p>
            <q class="receipt-sentence">a coaster with a photo of my dog Ash</q>
            <p class="receipt-meta">Photo taken at lunch. Sentence sent. In hand by dinner.</p>
            <p class="receipt-printer">Bambu Lab A1 Mini</p>
          </figcaption>
        </figure>

        <!-- Door 2: a hundred this week.  Kiln-branded ashtray —
             the startup-merch / your-own-factory promise. -->
        <figure class="receipt" data-reveal style="--reveal-delay: 0.08s">
          <div class="receipt-img-wrap">
            <img
              src="/demo/kiln-ashtray.jpg"
              alt="A red 3D-printed circular ashtray held in a hand, with the Kiln mark debossed into the inside"
              loading="lazy"
              width="1200"
              height="1600"
            />
          </div>
          <figcaption class="receipt-caption">
            <p class="receipt-kicker">Or a hundred, this week</p>
            <q class="receipt-sentence">an ashtray with our startup&rsquo;s logo</q>
            <p class="receipt-meta">Logo dropped in. Run queued. First of 100 by launch night.</p>
            <p class="receipt-printer">Bambu Lab A1 Mini</p>
          </figcaption>
        </figure>
      </div>

      <div class="receipts-video" data-reveal>
        <p class="receipts-video-label">The full run</p>
        <div class="receipts-video-wrap">
          <video
            src="/demo/kiln-demo-real.mp4"
            autoplay
            muted
            loop
            playsinline
            controls
            preload="metadata"
            aria-label="A Kiln agent runs the end-to-end pipeline: design, slice, print, monitor"
          ></video>
        </div>
      </div>
    </div>
  </section>

  <section class="bordered kit-promise">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>From idea to a printed product in an afternoon. Manual included. <span class="kit-pro-pill">Business</span></h2>
        <p class="lead">Multi-part prints ship with a printable PDF assembly manual &mdash; Bill of Materials, isometric step renders, pause-and-check verification gates.</p>
      </div>
      <div class="manual-proof">
        <figure data-reveal>
          <img src="/assets/manual-screenshots/desk-hook-cover.png" alt="Cover page of a Kiln-generated Desk Hook Kit assembly manual with labelled parts and scan-to-verify QR code" loading="lazy" width="1224" height="1584" />
          <figcaption>Cover page &mdash; labelled parts, QR verification, and build summary</figcaption>
        </figure>
        <figure data-reveal style="--reveal-delay: 0.08s">
          <img src="/assets/manual-screenshots/desk-hook-step-02.png" alt="Kiln-generated manual step page showing the hook arm snapping into the back plate with labelled parts, direction arrow, and instruction copy" loading="lazy" width="1224" height="1584" />
          <figcaption>Per-step page &mdash; part labels, mating arrow, and exact instruction copy</figcaption>
        </figure>
        <figure data-reveal style="--reveal-delay: 0.16s">
          <img src="/assets/manual-screenshots/desk-hook-step-03.png" alt="Final step of a Kiln-generated Desk Hook Kit manual with the current part highlighted and a warning check below the instruction" loading="lazy" width="1224" height="1584" />
          <figcaption>Final step &mdash; current part highlighted with a pause-and-check warning</figcaption>
        </figure>
      </div>
      <p class="manual-proof-caption">A real PDF generated by Kiln from a simple 3-part desk hook kit &mdash; cover, mid-build, and final step from the same manual.</p>
    </div>
  </section>

  <GitForThreeDHighlight />

  <FeatureGrid
    limit={5}
    moreLink="/features"
    lead="The five capabilities that make Kiln, Kiln."
  />
  <Steps />
  <ComparisonTable />

  <!--
    Intellectual property band — added 2026-05-16 as part of the
    patent-shield rewrite.  Replaces the per-row "Patent Pending"
    badges on the comparison table (13 badges that mapped the
    moat row-by-row) and the per-surface breakdown that used to
    live in the pricing footer.  One quiet, generic line in a
    Series-A-deck "Defensibility" treatment: confirms substance
    without naming filing surfaces a competitor could design
    around.  Same statement appears in the pricing footer; do
    not let the two strings drift.
  -->
  <section class="ip-band bordered">
    <div class="container">
      <p class="ip-label">Intellectual Property</p>
      <p class="ip-statement">Kiln's core technology is protected by multiple US patents pending.</p>
    </div>
  </section>

  <!--
    Topic hub — demoted on 2026-04-25 from section 5 to section 9.
    Rationale: docs navigation doesn't sell, it reassures.
    Reassurance belongs after the visitor is already convinced.
    Curious researchers and existing users still find it; they're
    patient enough to scroll.
  -->
  <section class="topic-hub bordered">
    <div class="container">
      <h2 data-reveal>Explore Kiln by topic</h2>
      <p class="lead" data-reveal style="--reveal-delay: 0.06s">Everything you need for setup, integrations, operations, and production workflows.</p>

      <div class="hub-grid">
        <a href="/install" class="card card-lift hub-card" data-reveal>
          <h3>Install and setup</h3>
          <p>Quick install, first printer connection, and MCP server setup.</p>
        </a>
        <a href="/integrations" class="card card-lift hub-card" data-reveal style="--reveal-delay: 0.06s">
          <h3>Printer and ecosystem integrations</h3>
          <p>OctoPrint, Moonraker, Creality, Bambu Lab, Prusa Link, Elegoo, marketplaces, and fulfillment.</p>
        </a>
        <a href="/printers" class="card card-lift hub-card" data-reveal style="--reveal-delay: 0.12s">
          <h3>Is your printer supported?</h3>
          <p>Tuned profiles for dozens of models across a dozen brands — Bambu Lab, Creality, Prusa, Elegoo, Sovol, Voron, and more. Find yours.</p>
        </a>
        <a href="/use-cases" class="card card-lift hub-card" data-reveal style="--reveal-delay: 0.18s">
          <h3>Use cases</h3>
          <p>Print farm automation, AI prototyping, outsourced production, and lab operations.</p>
        </a>
        <a href="/docs" class="card card-lift hub-card" data-reveal style="--reveal-delay: 0.24s">
          <h3>Documentation</h3>
          <p>CLI, MCP tools, safety architecture, and full configuration reference.</p>
        </a>
        <a href="/blog" class="card card-lift hub-card" data-reveal style="--reveal-delay: 0.3s">
          <h3>Releases and updates</h3>
          <p>Feature launches, integration announcements, and real-world print stories.</p>
        </a>
        <a href="/faq" class="card card-lift hub-card hub-card-wide" data-reveal style="--reveal-delay: 0.36s">
          <span class="hub-wide-main">
            <h3>FAQ</h3>
            <p>Answers on pricing, compatibility, deployment, safety, and operations.</p>
          </span>
          <svg class="hub-wide-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13.5 6.5 19 12l-5.5 5.5"/></svg>
        </a>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  /* ---- Intellectual property band ---- *
   * Quiet, considered "Defensibility" treatment.  Single label
   * + single statement, no list, no badges.  Strict rule: the
   * statement string must match the .patent-footer copy in
   * pricing.astro verbatim.  Drift here = drift in the IP
   * signal; keep them identical.  Deliberately shorter than the
   * global section rhythm and with no scroll reveal — this band
   * should be felt, not noticed. */
  .ip-band {
    padding: 52px 0;
    text-align: center;
  }
  .ip-label {
    font-size: 11px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-subtle);
    margin-bottom: 10px;
  }
  .ip-statement {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Kit-promise — sells the "from object to product" escalation
     after the receipts grid.  Head uses the global .section-head
     unit; only the tier pill and proof strip are page-scoped. */

  /* Pro pill on the kit-promise heading.  Mirrors .g3d-pro-pill in
     GitForThreeDHighlight.astro so both Pro-tier sections wear the
     same quiet tier signal — visual consistency across the page. */
  .kit-pro-pill {
    display: inline-block;
    vertical-align: middle;
    margin-left: 14px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    position: relative;
    top: -0.15em;
  }

  /* 3-image proof strip below the kit-promise heading.  Square
     PNGs rendered by Kiln's assembly-manual generator on a cream
     background; the figcaption sits below each image as a quiet
     label.  Grid collapses to single-column under 720px. */
  .manual-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1040px;
    margin: 0 auto;
  }
  .manual-proof figure {
    margin: 0;
    min-width: 0;
    text-align: center;
  }
  .manual-proof img {
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    /* Paper color of the rendered manual pages — content-derived,
       not a surface token; keeps PNG edges seamless. */
    background: #fff8ee;
    display: block;
    box-shadow: 0 20px 48px -28px rgba(0, 0, 0, 0.55);
  }
  .manual-proof figcaption {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .manual-proof-caption {
    margin: 32px auto 0;
    font-size: 13px;
    color: var(--text-muted);
    max-width: 720px;
    font-style: italic;
    text-align: center;
  }
  @media (max-width: 720px) {
    .manual-proof {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: min(100%, 420px);
      width: 100%;
    }
  }

  /* Fixed 3-column grid so the six topic cards always land as a clean
     3×2 block; the seventh (FAQ) spans the full width below as a
     deliberate closing row rather than a lonely orphan cell. */
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  /* Topic cards compose the global .card/.card-lift glass surface;
     only the inner type is page-scoped. */
  .hub-card {
    display: block;
    text-decoration: none;
  }
  .hub-card h3 {
    color: var(--text);
    font-size: var(--text-h3);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .hub-card p {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  /* Full-width closing card — turns the odd seventh topic into an
     intentional section footer instead of a half-empty orphan row.
     Title + blurb sit inline on the left, an ember arrow trails right. */
  .hub-card-wide {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .hub-wide-main {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    min-width: 0;
  }
  .hub-card-wide h3 {
    margin-bottom: 0;
  }
  .hub-card-wide p {
    font-size: 14.5px;
  }
  .hub-wide-arrow {
    flex-shrink: 0;
    color: var(--text-subtle);
    transition: color 0.2s ease, transform 0.25s var(--ease-out);
  }
  .hub-card-wide:hover .hub-wide-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* Mirror the old auto-fit responsiveness: 3 cols → 2 on tablets →
     1 on phones.  The wide closer spans whatever the column count is
     via grid-column: 1 / -1, so it stays full-width at every step. */
  @media (max-width: 900px) {
    .hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .hub-grid {
      grid-template-columns: 1fr;
    }
    .hub-card-wide {
      align-items: flex-start;
      gap: 16px;
    }
  }

  /* Receipts — demo section.  Object-first, no Telegram-screenshot
     grid, no "Read the full story" link punt.  Two hero prints
     captioned with the sentence that produced them, sitting above
     the unedited 1:18 agent-run video.  Treated as a gallery:
     generous gaps, framed plates, editorial serif captions. */
  .receipts {
    text-align: center;
  }
  .receipts-heading {
    /* Heading + subtitle act as a tight pair — keep them visually
       glued (16px gap) and let the subtitle carry the breath
       before the photo grid below.  Heading max-width tuned so
       "One thing today. Or a hundred this week." wraps into two
       balanced lines on every viewport, making the cadence
       visible: promise A. promise B. */
    margin: 0 auto 16px;
    max-width: 760px;
  }
  /* Subtitle under the new two-promise heading.  Carries the
     "at-home / your-own-factory" half of Adam's value props so
     neither door has to wait for the captions to deliver it. */
  .receipts-sub {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto 80px;
    text-wrap: pretty;
  }
  /* Per-photo kicker — names which door the visitor is looking
     at without making them parse the caption.  Same uppercase
     voice as the run-video label below for vertical symmetry. */
  .receipt-kicker {
    font-size: 11px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin: 0 0 12px;
  }

  .receipts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    margin: 0 auto 112px;
    max-width: 920px;
  }
  @media (max-width: 720px) {
    .receipts-grid {
      grid-template-columns: 1fr;
      gap: 72px;
    }
  }

  .receipt {
    margin: 0;
    min-width: 0;
    text-align: left;
  }
  .receipt-img-wrap {
    /* Portrait 3:4 frame — natural iPhone photo shape without
       cropping the object.  Subject stays comfortably in view. */
    aspect-ratio: 3 / 4;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 28px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 28px 64px -36px rgba(0, 0, 0, 0.65);
  }
  .receipt-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .receipt-caption {
    padding: 0 6px;
  }
  /* The sentence — rendered in the editorial serif as a quote.
     This is the "what they said" half of the prompt/result pair;
     the image is the "what they got."  Together they ARE the demo. */
  .receipt-sentence {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(21px, 2.2vw, 27px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 12px;
    text-wrap: pretty;
    quotes: "\201C" "\201D";
  }
  .receipt-sentence::before { content: open-quote; }
  .receipt-sentence::after { content: close-quote; }
  .receipt-meta {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    letter-spacing: 0.01em;
  }
  /* Printer attribution — split off the meta line on 2026-04-25
     to let the three-beat poem above ("Photo taken at lunch.
     Sentence sent. In hand by dinner.") keep its rhythm without
     competing with a model number.  Reads as the receipt's
     printed-at-the-bottom strip — set in the mono as a quiet
     machine plate. */
  .receipt-printer {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-subtle);
    margin: 10px 0 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Full-run video block — framed the same as the object plates
     (same border radius, same border, same dark fill) so the
     section reads as one designed surface.  Quiet uppercase label
     above mirrors the kicker at the top of the section for
     vertical symmetry. */
  .receipts-video {
    max-width: 960px;
    margin: 0 auto;
  }
  .receipts-video-label {
    font-size: 12px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin: 0 0 20px;
  }
  .receipts-video-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-code);
    aspect-ratio: 16 / 9;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 28px 64px -36px rgba(0, 0, 0, 0.65);
  }
  .receipts-video-wrap video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  @media (max-width: 720px) {
    .receipts-sub { margin-bottom: 56px; }
    .receipts-grid { margin-bottom: 72px; }
  }

</style>
</BaseLayout>
