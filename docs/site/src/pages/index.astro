---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GitForThreeDHighlight from '../components/GitForThreeDHighlight.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Steps from '../components/Steps.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CTA from '../components/CTA.astro';

---

<BaseLayout
  title="Kiln 3D — Connect AI Agents to 3D Printers | OctoPrint, Bambu, Moonraker"
  description="Kiln 3D is open-source infrastructure that lets AI agents design objects, discover models, and safely operate OctoPrint, Moonraker, Bambu Lab, Elegoo, and Prusa printers through one MCP server and CLI."
  keywords={[
    'ai agent tools for 3d printers',
    'connect ai to 3d printer',
    'open source 3d printer tools',
    '3d printer tools for ai agents',
    'use ai with 3d printer',
    'mcp server 3d printing',
  ]}
>
  <Hero />

  <section class="bordered learning-curve">
    <div class="container">
      <h2 class="lc-heading">The 3D printing learning curve is over. Kiln ended it.</h2>
      <p class="lc-lead">
        No Blender. No Fusion. No YouTube rabbit hole. Kiln turns a sentence into a physical object &mdash; on any 3D printer, start to finish.
      </p>
    </div>
  </section>

  <GitForThreeDHighlight />

  <section class="compat-strip-section bordered">
    <div class="container">
      <div class="compat-strip-inline">
        <p class="compat-title-inline">Works with your printer</p>
        <div class="compat-list-inline">
          <span class="printer-pill">OctoPrint</span>
          <span class="printer-pill">Moonraker/Klipper</span>
          <span class="printer-pill">Bambu Lab</span>
          <span class="printer-pill">Prusa Link</span>
          <span class="printer-pill">Elegoo</span>
          <span class="printer-pill">Direct USB</span>
        </div>
        <p class="compat-sub-inline">6 native adapters. Same commands work across all of them.</p>
      </div>
    </div>
  </section>

  <section class="topic-hub bordered">
    <div class="container">
      <h2>Explore Kiln by topic</h2>
      <p class="lead">Everything you need for setup, integrations, operations, and production workflows.</p>

      <div class="hub-grid">
        <a href="/install" class="hub-card">
          <h3>Install and setup</h3>
          <p>Quick install, first printer connection, and MCP server setup.</p>
        </a>
        <a href="/integrations" class="hub-card">
          <h3>Printer and ecosystem integrations</h3>
          <p>OctoPrint, Moonraker, Bambu Lab, Prusa Link, Elegoo, marketplaces, and fulfillment.</p>
        </a>
        <a href="/use-cases" class="hub-card">
          <h3>Use cases</h3>
          <p>Print farm automation, AI prototyping, outsourced production, and lab operations.</p>
        </a>
        <a href="/docs" class="hub-card">
          <h3>Documentation</h3>
          <p>CLI, MCP tools, safety architecture, and full configuration reference.</p>
        </a>
        <a href="/blog" class="hub-card">
          <h3>Releases and updates</h3>
          <p>Feature launches, integration announcements, and real-world print stories.</p>
        </a>
        <a href="/faq" class="hub-card">
          <h3>FAQ</h3>
          <p>Answers on pricing, compatibility, deployment, safety, and operations.</p>
        </a>
      </div>
    </div>
  </section>

  <FeatureGrid
    limit={5}
    moreLink="/features"
    lead="The five capabilities that make Kiln, Kiln."
  />
  <Steps />
  <ComparisonTable />

  <!--
    Receipts — demo section rebuilt on 2026-04-24 after the
    Jobs/Ive war-room flagged the previous "Real prints. Real
    agents." layout as the weakest surface on the page (produced
    video next to raw Telegram screenshots; printer-in-a-bedroom
    webcam chrome; "Read the full story →" CTA that punted off-
    page).  New shape follows Ive's "single object in studio
    conditions" instinct paired with Jobs' "homepage IS the story"
    rule: two real prints sit side-by-side captioned with the
    sentence that could have produced them, then the unedited
    full-run video underneath as proof-of-loop.  When better
    photography + more prints come in (tracked in
    kiln-pro/tasks.md), add a third card and consider a proper
    named-testimonial moat card beneath the grid.
  -->
  <section id="demo" class="receipts bordered">
    <div class="container">
      <h2 class="receipts-heading">A few words. A picture you already had. A real object in your hand.</h2>

      <div class="receipts-grid">
        <!-- Ash the dog, photo-decorated coaster -->
        <figure class="receipt">
          <div class="receipt-img-wrap">
            <img
              src="/demo/ash-coaster.jpg"
              alt="A white 3D-printed round coaster showing a relief portrait of a French bulldog and the name ASH along the bottom edge, held in a hand"
              loading="lazy"
              width="1200"
              height="1600"
            />
          </div>
          <figcaption class="receipt-caption">
            <q class="receipt-sentence">a coaster with a photo of my dog Ash</q>
            <p class="receipt-meta">Printed on a Bambu Lab A1 Mini</p>
          </figcaption>
        </figure>

        <!-- Kiln-branded ashtray — startup-merch prototype -->
        <figure class="receipt">
          <div class="receipt-img-wrap">
            <img
              src="/demo/kiln-ashtray.jpg"
              alt="A red 3D-printed circular ashtray held in a hand, with the Kiln mark debossed into the inside"
              loading="lazy"
              width="1200"
              height="1600"
            />
          </div>
          <figcaption class="receipt-caption">
            <q class="receipt-sentence">an ashtray with our startup&rsquo;s logo</q>
            <p class="receipt-meta">Printed on a Bambu Lab A1 Mini</p>
          </figcaption>
        </figure>
      </div>

      <div class="receipts-video">
        <p class="receipts-video-label">The full run</p>
        <div class="receipts-video-wrap">
          <video
            src="/demo/kiln-demo-real.mp4"
            autoplay
            muted
            loop
            playsinline
            controls
            preload="metadata"
            aria-label="A Kiln agent runs the end-to-end pipeline: design, slice, print, monitor"
          ></video>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .bordered {
    border-top: 1px solid var(--border);
  }

  /* Learning-curve kill — the second-beat angle, sized to read as
     a hero echo, not a body section.  Pairs typographically with
     Hero.astro's .tagline (weight 800, tight tracking) so the two
     most important sentences on the page visibly rhyme. */
  .learning-curve {
    text-align: center;
    padding: 112px 0 96px;
  }
  .lc-heading {
    font-size: clamp(30px, 4.8vw, 54px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--text);
    margin: 0 auto 22px;
    max-width: 880px;
    text-wrap: balance;
  }
  .lc-lead {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto;
    text-wrap: pretty;
  }
  @media (max-width: 640px) {
    .learning-curve { padding: 72px 0 60px; }
  }

  .topic-hub {
    /* Symmetric vertical padding so the section breathes evenly
       between its border-top and the next section's border. */
    padding: 72px 0 80px;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }

  .hub-card {
    display: block;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .hub-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .hub-card h3 {
    color: var(--text);
    font-size: 18px;
    margin-bottom: 8px;
  }

  .hub-card p {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  /* Receipts — demo section.  Object-first, no Telegram-screenshot
     grid, no "Read the full story" link punt.  Two hero prints
     captioned with the sentence that produced them, sitting above
     the unedited 1:18 agent-run video.  Typography matches the
     learning-curve + Git-for-3D sections above so the page reads
     as one unified system. */
  .receipts {
    padding: 120px 0;
    text-align: center;
  }
  .receipts-heading {
    font-size: clamp(24px, 3.4vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    /* Slightly narrower max-width than the hero to encourage the
       three-beat heading to wrap into 2–3 visual lines, which makes
       the cadence visible: input. input. output. */
    margin: 0 auto 72px;
    max-width: 600px;
    text-wrap: balance;
  }

  .receipts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin: 0 auto 96px;
    max-width: 880px;
  }
  @media (max-width: 720px) {
    .receipts-grid {
      grid-template-columns: 1fr;
      gap: 64px;
    }
  }

  .receipt {
    margin: 0;
    text-align: left;
  }
  .receipt-img-wrap {
    /* Portrait 3:4 frame — natural iPhone photo shape without
       cropping the object.  Subject stays comfortably in view. */
    aspect-ratio: 3 / 4;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 24px;
  }
  .receipt-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .receipt-caption {
    padding: 0 4px;
  }
  /* The sentence — rendered as a soft italic quote.  This is the
     "what they said" half of the prompt/result pair; the image is
     the "what they got."  Together they ARE the demo. */
  .receipt-sentence {
    display: block;
    font-size: clamp(17px, 1.7vw, 20px);
    font-weight: 500;
    line-height: 1.45;
    color: var(--text);
    font-style: italic;
    margin-bottom: 10px;
    text-wrap: pretty;
    quotes: "\201C" "\201D";
  }
  .receipt-sentence::before { content: open-quote; }
  .receipt-sentence::after { content: close-quote; }
  .receipt-meta {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
    letter-spacing: 0.01em;
  }

  /* Full-run video block — framed the same as the object cards
     (same border radius, same border, same dark fill) so the
     section reads as one designed surface.  Quiet uppercase label
     above mirrors the kicker at the top of the section for
     vertical symmetry. */
  .receipts-video {
    max-width: 960px;
    margin: 0 auto;
  }
  .receipts-video-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    margin: 0 0 18px;
  }
  .receipts-video-wrap {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
    aspect-ratio: 16 / 9;
  }
  .receipts-video-wrap video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  @media (max-width: 720px) {
    .receipts { padding: 72px 0; }
    .receipts-heading { margin-bottom: 48px; }
    .receipts-grid { margin-bottom: 64px; }
  }

  /* Printer compat strip (after "What is Kiln 3D?") */
  .compat-strip-section {
    padding: 40px 0;
  }
  .compat-strip-inline {
    text-align: center;
    padding: 40px 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .compat-title-inline {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .compat-list-inline {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }
  .printer-pill {
    display: inline-block;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .printer-pill:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .compat-sub-inline {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
