---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import VercelAnalytics from '../components/VercelAnalytics.astro';
import MetaPixel from '../components/MetaPixel.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleAdsConversion from '../components/GoogleAdsConversion.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: string;
  type?: 'website' | 'article';
  image?: string;
  keywords?: string[];
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  current = '',
  type = 'website',
  image,
  keywords,
  noindex = false,
  schema,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <SeoHead
    title={title}
    description={description}
    type={type}
    image={image}
    keywords={keywords}
    noindex={noindex}
    schema={schema}
  />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Fonts: variable Inter (optical sizing for display sizes), an
       editorial serif for accent words, mono for code. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..800;1,14..32,400..700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Marks the document as JS-capable before first paint so the
       scroll-reveal styles only ever hide content when the observer
       below is guaranteed to run. -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <VercelAnalytics />
</head>
<body>
  <Nav current={current} />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- Marketing tracking — env-gated dormant; nothing renders
       until PUBLIC_META_PIXEL_ID / PUBLIC_GA4_MEASUREMENT_ID /
       PUBLIC_GOOGLE_ADS_CONVERSION_ID are set on Vercel.  Each
       script also gates on `kiln_consent` cookie at script-init
       time (advertising for Meta/Google-Ads, analytics for GA4).
       See PRIVACY.md §3.2 for disclosure. -->
  <MetaPixel />
  <GoogleAnalytics />
  <GoogleAdsConversion />
  <CookieBanner />

  <!-- Scroll reveal: flips data-reveal elements to .is-revealed.
       Elements already in the viewport reveal immediately (the hero
       entrance never depends on observer timing); everything below the
       fold reveals on first intersection.  A watchdog reveals the rest
       if the observer never delivers its mandatory initial callback —
       content visibility must not have a single point of failure.
       Reduced-motion users get content immediately via the media query
       in global.css; no-JS users never hide content because the hiding
       styles are scoped to html.js. -->
  <script is:inline>
    (() => {
      const els = Array.from(document.querySelectorAll('[data-reveal]'));
      if (!els.length) return;
      const revealAll = () => els.forEach((el) => el.classList.add('is-revealed'));
      if (!('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        revealAll();
        return;
      }

      const vh = window.innerHeight || document.documentElement.clientHeight;
      const pending = [];
      for (const el of els) {
        const r = el.getBoundingClientRect();
        if (r.top < vh * 0.96 && r.bottom > 0) el.classList.add('is-revealed');
        else pending.push(el);
      }
      if (!pending.length) return;

      let alive = false;
      const io = new IntersectionObserver((entries) => {
        alive = true;
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        }
      }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
      pending.forEach((el) => io.observe(el));

      // Per spec the observer reports initial state asynchronously but
      // promptly.  If nothing has arrived shortly after load, treat the
      // observer as broken and show everything.
      window.setTimeout(() => {
        if (!alive) { revealAll(); io.disconnect(); }
      }, 1200);
    })();
  </script>
</body>
</html>
