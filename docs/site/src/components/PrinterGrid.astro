---
const printers = [
  { name: 'OctoPrint', desc: 'REST API \u00B7 Any printer with OctoPrint' },
  { name: 'Moonraker', desc: 'REST API \u00B7 Klipper-based printers' },
  { name: 'Creality', desc: 'Moonraker-backed \u00B7 K1, K2, Hi, Ender V3 KE' },
  { name: 'Bambu Lab', desc: 'MQTT \u00B7 X1C, P1S, A1 Mini, A1' },
  { name: 'Elegoo', desc: 'WebSocket/SDCP \u00B7 Centauri Carbon, Saturn, Mars' },
  { name: 'Prusa Link', desc: 'REST API \u00B7 MK4, MINI+, XL' },
  { name: 'Direct USB', desc: 'Serial \u00B7 Any Marlin printer over USB' },
];
---

<section class="bordered">
  <div class="container">
    <div class="section-head">
      <h2 data-reveal>Supported printers</h2>
      <p class="lead" data-reveal style="--reveal-delay: 0.06s">Works with the most popular 3D printer ecosystems out of the box.</p>
    </div>

    <div class="printer-grid">
      {printers.map((p, i) => (
        <div class="printer-card card" data-reveal style={`--reveal-delay: ${Math.min(i * 0.05, 0.3)}s`}>
          <div class="name">{p.name}</div>
          <div class="desc">{p.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .printer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 900px) {
    .printer-grid {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
  }
  .printer-card {
    padding: 26px 24px;
    text-align: center;
  }
  .name {
    font-weight: 600;
    font-size: 15.5px;
    letter-spacing: -0.012em;
    margin-bottom: 5px;
  }
  .desc {
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
