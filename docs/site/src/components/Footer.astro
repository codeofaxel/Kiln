---
// Footer — grouped, quiet, in the same visual language as Nav.astro.
//
// The old footer was a single flat row of 10 links + "Built by
// codeofaxel" vanity byline.  At this stage the byline reads as
// a personal-project tell; removed.  Links are now grouped by
// intent (Product / Docs / Company / Connect) with the donate +
// contact blocks preserved but quieted visually.
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <div class="col-label">Product</div>
        <a href="/install">Install</a>
        <a href="/use-cases">Use Cases</a>
        <a href="/integrations">Integrations</a>
        <a href="/pricing">Pricing</a>
      </div>
      <div class="footer-col">
        <div class="col-label">Docs</div>
        <a href="/docs">Reference</a>
        <a href="/whitepaper">Whitepaper</a>
        <a href="/litepaper">Litepaper</a>
        <a href="/faq">FAQ</a>
      </div>
      <div class="footer-col">
        <div class="col-label">Company</div>
        <a href="/blog">Blog</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="https://github.com/codeofaxel/Kiln/blob/main/LICENSE" target="_blank" rel="noopener">AGPL-3.0</a>
      </div>
      <div class="footer-col">
        <div class="col-label">Connect</div>
        <a href="https://github.com/codeofaxel/Kiln" target="_blank" rel="noopener">GitHub</a>
        <a href="mailto:adam@kiln3d.com">adam@kiln3d.com</a>
        <a href="https://x.com/kiln3d" target="_blank" rel="noopener">X &middot; @kiln3d</a>
        <a href="https://www.instagram.com/kiln3d" target="_blank" rel="noopener">Instagram &middot; @kiln3d</a>
        <a href="https://x.com/adamaarreola" target="_blank" rel="noopener">X &middot; @adamaarreola</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="donate">
        Donate &amp; support development:
        <code>kiln3d.sol</code>
        <span class="chain">(Solana)</span>
        &middot;
        <code>kiln3d.eth</code>
        <span class="chain">(Ethereum)</span>
      </p>
      <p class="parent-company">Kiln is a project of Hadron Labs Inc.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    background: rgba(15, 15, 15, 0.6);
    padding: 56px 0 40px;
    font-size: 13px;
    color: var(--text-muted);
  }
  footer a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color .12s ease;
  }
  footer a:hover {
    color: var(--text);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    margin-bottom: 4px;
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    text-align: center;
  }

  .donate {
    margin: 0;
    font-size: 13px;
    color: var(--text-muted);
  }
  .donate code {
    font-family: var(--mono);
    color: var(--accent);
    font-weight: 600;
    font-size: 13px;
  }
  .donate .chain {
    color: var(--text-muted);
    opacity: 0.7;
  }

  .parent-company {
    margin: 0;
    font-size: 12px;
    color: var(--text-muted);
    opacity: 0.7;
  }

  @media (max-width: 720px) {
    footer {
      padding: 40px 0 32px;
    }
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px 24px;
      margin-bottom: 36px;
    }
  }
</style>
