---
---

<div class="hero">
  <div class="container">
    <img src="/assets/kiln-pfp-1024-flat.svg" alt="Kiln" class="hero-logo" width="300" height="300">
    <p class="tagline"><span class="tagline-line">Describe it or draw it.</span><br><span class="tagline-emphasis">Kiln makes it real.</span></p>
    <h1><span class="brand">Kiln 3D</span> lets AI agents <span class="accent">safely</span> control 3D printers</h1>
    <p class="subtitle">
      The intelligence layer between your idea and a physical object.
    </p>

    <p class="install-label">Get started</p>
    <div class="install-block">
      <code><span class="prompt">$</span> pip install kiln3d</code>
      <button class="copy-install">Copy</button>
    </div>
    <p class="install-alt">
      Then connect your printer and create objects with AI.
    </p>

    <div class="badges">
      <a href="https://github.com/codeofaxel/Kiln/actions/workflows/ci.yml" target="_blank" rel="noopener">
        <img src="https://github.com/codeofaxel/Kiln/actions/workflows/ci.yml/badge.svg" alt="CI" width="90" height="20">
      </a>
      <img src="https://img.shields.io/badge/python-3.10%E2%80%933.13-blue" alt="Python 3.10-3.13" width="120" height="20">
      <img src="https://img.shields.io/badge/license-AGPL--3.0-green" alt="AGPL-3.0 License" width="100" height="20">
      <img src="https://img.shields.io/badge/tests-9%2C600%2B%20passed-brightgreen" alt="Tests" width="130" height="20">
      <img src="https://img.shields.io/badge/MCP%20tools-544-orange" alt="544 MCP Tools" width="120" height="20">
    </div>
  </div>
</div>

<script>
  const copyBtn = document.querySelector('.copy-install');
  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText('pip install kiln3d');
    if (copyBtn) {
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
    }
  });
</script>

<style>
  .hero {
    padding: 100px 0 80px;
    text-align: center;
  }
  .hero-logo {
    width: clamp(200px, 25vw, 340px);
    height: auto;
    border-radius: 48px;
    margin-bottom: 44px;
    filter: drop-shadow(0 0 60px rgba(245, 158, 66, 0.25)) drop-shadow(0 0 120px rgba(245, 158, 66, 0.1));
    transition: filter 0.3s ease;
  }
  .hero-logo:hover {
    filter: drop-shadow(0 0 80px rgba(245, 158, 66, 0.35)) drop-shadow(0 0 160px rgba(245, 158, 66, 0.15));
  }

  /* Primary tagline — the emotional hero statement */
  .tagline {
    font-size: clamp(28px, 4.5vw, 64px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    color: var(--text);
  }
  .tagline-line,
  .tagline-emphasis {
    white-space: nowrap;
  }
  .tagline-emphasis {
    background: linear-gradient(135deg, var(--accent), #f59e42, var(--accent));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 6s ease-in-out infinite;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Secondary H1 — SEO-optimized, visually subordinate */
  .hero h1 {
    font-size: clamp(18px, 2.8vw, 26px);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 16px;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }
  .hero h1 .brand {
    font-weight: 600;
    color: var(--text);
  }
  .hero h1 .accent { color: var(--accent); font-weight: 600; }

  .subtitle {
    font-size: clamp(16px, 2.5vw, 20px);
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.5;
  }

  /* Install block */
  .install-label {
    font-size: clamp(14px, 2vw, 16px);
    font-weight: 600;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .install-block {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px 28px;
    max-width: 720px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    overflow: hidden;
  }
  .install-block code {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .install-block .prompt { color: var(--accent); }
  .install-block button {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-family: var(--font);
    font-size: 12px;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .install-block button:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .install-alt {
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 40px;
  }
  .install-alt code {
    font-family: var(--mono);
    font-size: 13px;
  }

  /* Badges */
  .badges {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }
  .badges img { height: 22px; width: auto; }

  @media (max-width: 640px) {
    .hero { padding: 60px 0 50px; }
    .tagline { margin-bottom: 20px; }
    .install-block { flex-direction: column; text-align: center; }
  }
</style>
