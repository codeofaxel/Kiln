---
---

<div class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container">
    <img src="/assets/kiln-pfp-1024-flat.svg" alt="Kiln" class="hero-logo" width="128" height="128" data-reveal>
    <p class="tagline" data-reveal style="--reveal-delay: 0.07s"><span class="tagline-line">Spawn an object</span><br><span class="tagline-emphasis serif-accent">into existence.</span></p>
    <h1 data-reveal style="--reveal-delay: 0.14s"><span class="brand">Kiln 3D</span> is how AI agents make real things &mdash; <span class="accent">safely</span>, on any 3D printer.</h1>
    <p class="subtitle" data-reveal style="--reveal-delay: 0.2s">
      Describe what you want. Kiln designs, prints, and monitors it &mdash; then branches, merges, and signs the version that works.
    </p>

    <!-- BYO compat strip — promoted into the hero on 2026-04-26
         to replace the install block.  The model-agnostic
         compatibility message now sits above the fold instead of
         below the receipts.
         Sub-line "any printer" tightens to "any machine" when CNC
         / laser adapters land. -->
    <h2 class="compat-heading" data-reveal style="--reveal-delay: 0.26s">Bring your AI. We brought the rest.</h2>
    <div class="compat-strip-inline" data-reveal style="--reveal-delay: 0.32s">
      <p class="compat-row-label">Agents</p>
      <div class="compat-list-inline">
        <span class="compat-pill">Claude</span>
        <span class="compat-pill">Codex</span>
        <span class="compat-pill">Cursor</span>
        <span class="compat-pill">OpenClaw</span>
        <span class="compat-pill compat-pill-more">+ any MCP agent</span>
      </div>
      <p class="compat-row-label">Printers</p>
      <div class="compat-list-inline">
        <span class="compat-pill">OctoPrint</span>
        <span class="compat-pill">Moonraker/Klipper</span>
        <span class="compat-pill">Creality</span>
        <span class="compat-pill">Bambu Lab</span>
        <span class="compat-pill">Prusa Link</span>
        <span class="compat-pill">Elegoo</span>
        <span class="compat-pill">Direct USB</span>
        <a href="/printers" class="compat-pill compat-pill-more">+ more brands</a>
      </div>
      <p class="compat-sub-inline">Plugs into any agent. Operates any printer.</p>
      <!-- Full supported-brand roster as crawlable text: the long-tail
           brand searches (Sovol, Voron, QIDI, RatRig, ...) have nowhere
           else above the fold to resolve, and the descriptive-anchor
           link funnels both the visitor and link authority to the
           searchable /printers list.  Brand order + count are generated
           from supported_printers.json (49 models / 12 brands); keep in
           sync if that data changes. -->
      <p class="compat-brands-inline">
        Tuned profiles for Creality, Bambu Lab, Elegoo, Prusa, Sovol, Voron, AnkerMake, Artillery, FlashForge, QIDI, RatRig &amp; SparkX. <a href="/printers" class="compat-brands-link">See if yours is supported &rarr;</a>
      </p>
    </div>

    <div class="hero-actions" data-reveal style="--reveal-delay: 0.38s">
      <a href="/install" class="btn hero-cta">Connect your AI &rarr;</a>
      <a href="#demo" class="link-arrow">See it work &darr;</a>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    padding: 96px 0 110px;
    text-align: center;
  }

  /* Ember horizon behind the headline — one large, very soft light
     source so the dark canvas reads as material instead of empty. */
  .hero-glow {
    position: absolute;
    inset: -140px 0 auto;
    height: 640px;
    pointer-events: none;
    background:
      radial-gradient(640px 360px at 50% 8%, rgba(255, 107, 43, 0.13), transparent 70%),
      radial-gradient(1100px 480px at 50% -4%, rgba(255, 147, 87, 0.06), transparent 75%);
    mask-image: linear-gradient(180deg, #000 65%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 65%, transparent);
  }

  .hero .container { position: relative; }

  /* The mark — sized as a presence, not a favicon.  Hairline ring +
     inner sheen make it read as a made object sitting in the ember
     light, the same way the printed pieces below sit in their frames. */
  .hero-logo {
    width: clamp(104px, 11vw, 132px);
    height: auto;
    border-radius: clamp(24px, 2.5vw, 30px);
    margin-bottom: 44px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 24px 48px -20px rgba(0, 0, 0, 0.8);
    filter: drop-shadow(0 0 36px rgba(245, 158, 66, 0.38)) drop-shadow(0 0 110px rgba(245, 158, 66, 0.16));
    transition: filter 0.4s ease, transform 0.4s var(--ease-out);
  }
  .hero-logo:hover {
    filter: drop-shadow(0 0 48px rgba(245, 158, 66, 0.5)) drop-shadow(0 0 140px rgba(245, 158, 66, 0.22));
    transform: translateY(-2px);
  }

  /* Primary tagline — the monumental statement.  Optical sizing comes
     from the variable font; tight leading + deep negative tracking are
     what make it read as set type rather than scaled body text. */
  .tagline {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.045em;
    margin-bottom: 30px;
    color: var(--text);
    text-wrap: balance;
  }
  .tagline-line,
  .tagline-emphasis {
    white-space: nowrap;
  }
  .tagline-emphasis {
    display: inline-block;
    padding-right: 0.06em; /* keep the italic's last glyph clear of the clip box */
    background: var(--ember-gradient);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 7s ease-in-out infinite;
  }
  .tagline .serif-accent {
    font-size: 1.04em;
    letter-spacing: -0.015em;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Secondary H1 — SEO-optimized, visually subordinate */
  .hero h1 {
    font-size: clamp(17px, 2.4vw, 22px);
    font-weight: 450;
    line-height: 1.45;
    margin-bottom: 14px;
    color: var(--text-muted);
    letter-spacing: -0.012em;
  }
  .hero h1 .brand {
    font-weight: 600;
    color: var(--text);
  }
  .hero h1 .accent { color: var(--accent); font-weight: 600; }

  .subtitle {
    font-size: clamp(16px, 2.2vw, 19px);
    color: var(--text-secondary);
    max-width: 660px;
    margin: 0 auto 56px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* BYO compat strip — sized smaller than the tagline so the
     monumental statement stays the visual anchor while the BYO claim
     acts as a secondary load-bearing line. */
  .compat-heading {
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--text);
    text-align: center;
    margin: 0 auto 22px;
    max-width: 780px;
    text-wrap: balance;
  }
  .compat-strip-inline {
    text-align: center;
    width: 100%;
    min-width: 0;
    padding: 30px 36px 26px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 24px 60px -32px rgba(0, 0, 0, 0.8);
    max-width: 760px;
    margin: 0 auto;
  }
  /* Tiny uppercase row label — separates the agents row from the
     printers row so a normie can parse the strip at a glance. */
  .compat-row-label {
    font-size: 11px;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-subtle);
    margin: 0 0 12px;
    text-align: center;
  }
  .compat-list-inline + .compat-row-label {
    margin-top: 22px;
  }
  .compat-list-inline {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 9px;
  }
  .compat-pill {
    display: inline-block;
    max-width: 100%;
    padding: 8px 17px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--text);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s var(--ease-out);
  }
  .compat-pill:hover {
    border-color: var(--border-accent);
    background: rgba(255, 107, 43, 0.07);
    transform: translateY(-1px);
  }
  /* Link pills (the printers "+ more brands" → /printers) keep the
     pill shape, never an underline. */
  a.compat-pill {
    text-decoration: none;
  }
  /* "+ any MCP agent" / "+ more brands" — dashed border + muted text
     reads as "and more" without a separate visual treatment. */
  .compat-pill-more {
    border-style: dashed;
    color: var(--text-muted);
    background: transparent;
  }
  .compat-pill-more:hover {
    color: var(--text);
    border-color: var(--border-accent);
    background: transparent;
  }
  .compat-sub-inline {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: 22px;
  }
  /* Full supported-brand roster — quiet line under the punchline. */
  .compat-brands-inline {
    font-size: 12.5px;
    color: var(--text-subtle);
    line-height: 1.6;
    margin: 8px auto 0;
    max-width: 600px;
    text-wrap: pretty;
  }
  .compat-brands-link {
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px dashed var(--border-strong);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .compat-brands-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Primary CTA row below the BYO strip — one filled action, one
     quiet anchor down to the proof section. */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    margin-top: 44px;
  }
  .hero-cta {
    font-size: 16px;
    padding: 16px 34px;
  }

  @media (max-width: 640px) {
    .hero { padding: 56px 0 64px; }
    .hero-logo { width: 96px; border-radius: 22px; margin-bottom: 32px; }
    .tagline { margin-bottom: 22px; }
    .tagline-line,
    .tagline-emphasis { white-space: normal; }
    .subtitle { margin-bottom: 40px; }
    .compat-strip-inline { padding: 24px 18px 22px; border-radius: var(--radius-lg); }
    .compat-heading { margin: 0 auto 18px; }
    .hero-actions { margin-top: 32px; flex-direction: column; gap: 18px; }
  }
</style>
