---
---

<div class="cta bordered">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="container">
    <h2 data-reveal>Let's <span class="serif-accent ink-ember">build.</span></h2>
    <p data-reveal style="--reveal-delay: 0.06s">Open source, AGPL-3.0 licensed, free for local printing forever.</p>
    <div class="cta-actions" data-reveal style="--reveal-delay: 0.12s">
      <a href="https://github.com/codeofaxel/Kiln" class="btn" target="_blank" rel="noopener">View on GitHub</a>
      <a href="/docs" class="btn btn-ghost">Read the Docs</a>
      <a href="/integrations" class="btn btn-ghost">Explore Integrations</a>
    </div>
    <div class="donate" data-reveal style="--reveal-delay: 0.18s">
      Donate &amp; support development: <code>kiln3d.sol</code> <span class="chain">(Solana)</span> &middot; <code>kiln3d.eth</code> <span class="chain">(Ethereum)</span>
    </div>
  </div>
</div>

<style>
  .cta {
    position: relative;
    text-align: center;
    padding: 140px 0 150px;
    overflow: hidden;
  }
  /* Closing ember — the page ends the way it opened, with a soft
     light source under the final statement. */
  .cta-glow {
    position: absolute;
    inset: auto 0 -260px;
    height: 520px;
    pointer-events: none;
    background: radial-gradient(720px 380px at 50% 100%, rgba(255, 107, 43, 0.12), transparent 70%);
  }
  .cta .container { position: relative; }
  .cta h2 {
    font-size: var(--text-h1);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin-bottom: 18px;
  }
  .cta h2 .serif-accent {
    font-size: 1.04em;
    padding-right: 0.06em;
  }
  .cta p {
    color: var(--text-secondary);
    margin-bottom: 40px;
    font-size: var(--text-lead);
  }
  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .cta-actions .btn-ghost { margin-left: 0; }
  .donate {
    margin-top: 56px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .donate code {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--accent);
    font-weight: 600;
  }
  .donate .chain {
    color: var(--text-subtle);
    font-size: 13px;
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .cta { padding: 88px 0 96px; }
  }
</style>
