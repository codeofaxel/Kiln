---
const steps = [
  'Idea',
  'Design',
  'Generate',
  'Validate',
  'Decorate',
  'Slice',
  'Print',
  'Monitor',
  // Iterate closes the loop — every outcome feeds the next branch.
  'Iterate',
];
---

<section id="how-it-works" class="steps bordered">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>How it works</h2>
      <p class="lead">From idea to physical object &mdash; then branch, merge, and print a better one.</p>
    </div>

    <ol class="steps-flow">
      {steps.map((label, i) => (
        <li class="step" data-reveal style={`--reveal-delay: ${Math.min(i * 0.05, 0.4).toFixed(2)}s`}>
          <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="step-label">{label}</span>
        </li>
      ))}
    </ol>

    <p class="steps-note" data-reveal style="--reveal-delay: 0.2s">
      Every step is an MCP tool. Agents compose the pipeline. Humans can run any step from the CLI. Every print outcome feeds the next iteration.
    </p>
  </div>
</section>

<style>
  .steps-flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    column-gap: 18px;
    row-gap: 36px;
  }

  /* Each step sits under its own segment of a machined hairline —
     the gaps between segments give the row its tick-mark rhythm. */
  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .step-num {
    font-family: var(--mono);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
  }

  /* The final step closes the loop — one ember numeral signals that
     the flow feeds back into the next iteration. */
  .step:last-child { border-top-color: var(--border-accent); }
  .step:last-child .step-num { color: var(--accent); }

  .step-label {
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: var(--text);
  }

  .steps-note {
    margin: 64px auto 0;
    max-width: 560px;
    text-align: center;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* Nine columns need ~900px to keep one-word labels on one line;
     below that the flow folds into a 3×3 loop. */
  @media (max-width: 900px) {
    .steps-flow {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 16px;
      row-gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .steps-note { margin-top: 44px; }
  }
</style>
