---
const steps = [
  {
    title: 'Install and connect',
    desc: 'One command installs Kiln. Connect any printer \u2014 OctoPrint, Bambu, Klipper, Prusa, Elegoo, or USB. Auto-discovery finds printers on your LAN.',
  },
  {
    title: 'Describe what you want',
    desc: 'Tell your AI agent what to make. Kiln handles design intelligence, generation, printability validation, and mesh preparation automatically.',
  },
  {
    title: 'Kiln handles the rest',
    desc: 'Slice with material-aware profiles, add decorations or textures, upload, print, monitor with AI vision, and recover from failures \u2014 all in one conversation.',
  },
  {
    title: 'Human stays in control',
    desc: 'Safety guardrails are enforced at the protocol level. Irreversible actions require human confirmation. 29 printer safety profiles protect your hardware.',
  },
];
---

<section id="how-it-works" class="bordered">
  <div class="container">
    <h2>How it works</h2>
    <p class="lead">
      Install Kiln, connect your printer, and let your AI agent handle the rest.
    </p>

    <div class="steps">
      {steps.map((s) => (
        <div class="step">
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bordered {
    border-top: 1px solid var(--border);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: 28px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .step::before {
    counter-increment: step;
    content: counter(step);
    display: block;
    width: 32px;
    height: 32px;
    line-height: 32px;
    text-align: center;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 14px;
  }
  .step h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .step p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
