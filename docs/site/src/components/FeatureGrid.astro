---
const features = [
  {
    icon: '\u{1F4A1}',
    title: 'Design Intelligence',
    desc: '27 FDM materials with full engineering properties, 36 brand-specific filament profiles, 20 proven design patterns (snap-fits, living hinges, threads), and structural load estimation. Kiln understands what makes a good print before generating anything.',
  },
  {
    icon: '\u2728',
    title: 'Text & Sketch to 3D',
    desc: 'Describe what you want or sketch it. Kiln generates printable models via Gemini Deep Think, Meshy, Tripo3D, Stability AI, or parametric OpenSCAD with a 14-component catalog (gears, threads, hinges, bearings). Design DNA preserves the source for iteration.',
  },
  {
    icon: '\u{1F52C}',
    title: 'Printability Engine',
    desc: 'Analyze models across 7 dimensions (overhangs, thin walls, bridging, adhesion, supports, warping, thermal stress), score 0\u2013100, auto-orient, repair broken meshes, and auto-scale AI-generated models. Problems get fixed, not just flagged.',
  },
  {
    icon: '\u{1F9E9}',
    title: 'Multi-Part Assembly',
    desc: 'Design assemblies with up to 10 parts (unlimited with Pro). Clearance validation, joint type detection (snap-fit, press-fit, threaded), tolerance stacking, and automatic split planning for oversize models.',
  },
  {
    icon: '\u{1F9EE}',
    title: 'Smart Cost Estimation',
    desc: 'Know what a print will cost before it starts \u2014 material, electricity, time. Get recommendations for cheaper filament alternatives, faster speed profiles, and quality tradeoffs.',
  },
  {
    icon: '\u{1F504}',
    title: 'Print \u2192 Monitor \u2192 Recover',
    desc: 'Full lifecycle: slice, validate safety, upload, print, control speed with natural language, monitor with camera vision, detect failures, diagnose root cause, auto-fix slicer settings, and retry. One conversation, start to finish.',
  },
  {
    icon: '\u{1F6E1}\uFE0F',
    title: 'Safety at Every Step',
    desc: "29 per-printer safety profiles with temperature and speed limits. G-code validation before every send. Preflight checks, emergency stop, heater watchdog, G-code interception. Agents can\u2019t bypass safety.",
  },
  {
    icon: '\u{1F30D}',
    title: 'Fleet & Fulfillment',
    desc: "Multi-printer fleet with job routing, scheduling, and failure rerouting. Print recovery with automatic retry. No local printer? Outsource to Craftcloud\u2019s 150+ third-party services. Same tools, same safety.",
  },
  {
    icon: '\u{1F3A8}',
    title: 'Surface Decoration',
    desc: 'Emboss or deboss QR codes, photos, logos, and text onto any model. Multicolor printing support for Bambu AMS. 3 decorations/month free, unlimited with Pro.',
  },
  {
    icon: '\u{1F30A}',
    title: 'Surface Textures',
    desc: 'Tiger stripe, marble, snakeskin, lava, wood grain, and more. Procedural and geometric patterns applied directly to any model with zero cloud dependencies. Pro feature.',
  },
  {
    icon: '\u{1F9F0}',
    title: 'Material & Mesh Intelligence',
    desc: '36 brand-specific filaments with purchase links and compatibility matching. Plus mesh repair, boolean ops, hollowing, chamfers, fillets, and wall thickening. Know what spool to buy and fix broken STLs.',
  },
  {
    icon: '\u{1F517}',
    title: '542 Tools, One Protocol',
    desc: "542 MCP tools and 142 CLI commands with --json output. Any MCP-compatible agent (Claude, GPT, custom) gets full access. Open source, AGPL-3.0 licensed, plugin-extensible.",
  },
];

const printerBackends = [
  'OctoPrint',
  'Moonraker/Klipper',
  'Bambu Lab',
  'Prusa Link',
  'Elegoo',
  'Direct USB',
];
---

<section id="features">
  <div class="container">
    <h2>How Kiln works</h2>
    <p class="lead">
      From your idea to a physical object &mdash; with intelligence at every step.
    </p>

    <div class="features">
      {features.map((f) => (
        <div class="feature">
          <div class="icon">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .feature {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 28px;
  }
  .icon {
    width: 40px;
    height: 40px;
    background: var(--accent-glow);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    font-size: 20px;
  }
  .feature h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .feature p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .compat-strip {
    margin-top: 48px;
    padding: 36px 32px;
    text-align: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .compat-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .compat-list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .compat-name {
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
  }
  .compat-dot {
    color: var(--text-muted);
    font-size: 18px;
    user-select: none;
  }
  .compat-sub {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
