{
  "_meta": {
    "version": "2.0.0",
    "description": "The slicer-profile roster: each printer's row is its display name. Since 2026-10-12 a printer's tuned PrusaSlicer/OrcaSlicer settings (INI-style key-value pairs written to a temporary .ini and passed to the slicer via --load, the recommended slicer, and the built-in tool-change record) are its catalogue record, served one printer at a time by Kiln and read through kiln.slicer_profiles.get_slicer_profile; a roster printer whose record this install does not hold slices with the generic 'default' profile, which stays bundled whole. The multi-material add-on definitions under _multi_material_addons stay bundled too.",
    "updated": "2026-10-12"
  },
  "_multi_material_addons": {
    "_description": "Optional multi-material add-on systems that can be attached to printers without built-in tool changers. Each add-on overrides the printer's default tool_change data when specified via tool_changer_addon parameter.",
    "creality_cfs": {
      "display_name": "Creality CFS-C (K1-series retrofit)",
      "tool_change_seconds": 38,
      "tool_changer": "cfs",
      "max_colors": 4,
      "compatible_printers": [
        "k1",
        "k1_max",
        "k1c",
        "k1_se"
      ],
      "requires_klipper": false,
      "hardware_unverified": true,
      "control_mode": "firmware_gcode_or_creality_print",
      "warnings": [
        "CFS-C slot control is hardware-unverified in Kiln; verify slot mapping on real hardware before unattended multicolor printing.",
        "Stock K1-series printers are single-material until the CFS-C hardware, firmware update, and compatible hotend path are installed."
      ],
      "notes": "Creality CFS-C retrofit for K1/K1 Max/K1C/K1 SE. One four-slot CFS-C unit; multiple CFS-C units are not supported. Requires CFS-C hardware, firmware update, and compatible quick-swap/integrated-nozzle hotend path. Source: Creality CFS-C product specs and K1 Series Multicolor Upgrade notes (2026)."
    },
    "mosaic_palette3": {
      "display_name": "Mosaic Palette 3 Pro",
      "tool_change_seconds": 28,
      "tool_changer": "palette",
      "max_colors": 8,
      "compatible_printers": [
        "_universal"
      ],
      "requires_klipper": false,
      "notes": "Pre-splicing system — filament is joined upstream before reaching the nozzle, so actual print pause is near-zero. 28s is the splice time; purge tower extrusion adds wall-clock time at print speed. Works with virtually any single-extruder FDM printer. Source: Mosaic product specs + splice tuning documentation."
    },
    "coprint_kcm": {
      "display_name": "Co Print KCM2",
      "tool_change_seconds": 30,
      "tool_changer": "kcm",
      "max_colors": 8,
      "compatible_printers": [
        "_klipper"
      ],
      "requires_klipper": true,
      "notes": "Klipper Chroma Module — 4s mechanical swap via 8-in-1 hub, plus ~26s purge. Compatible with any Klipper printer (Neptune 4, Voron, Sovol SV08, etc). Requires hardware install + custom Klipper macros. Source: Co Print product page + community benchmarks."
    },
    "chameleon_mk4": {
      "display_name": "3D Chameleon Mk4",
      "tool_change_seconds": 60,
      "tool_changer": "chameleon",
      "max_colors": 4,
      "compatible_printers": [
        "_universal"
      ],
      "requires_klipper": false,
      "notes": "Open-source universal multi-material system. Button-pulse timing at ~1 inch/sec filament movement. 30-35s mechanical swap + purge. Slowest add-on but cheapest and most universal. Up to 4 colors. Source: 3D Chameleon FAQ + GitHub Mk4 documentation."
    },
    "elegoo_canvas": {
      "display_name": "Elegoo CANVAS",
      "tool_change_seconds": 70,
      "tool_changer": "canvas",
      "max_colors": 4,
      "compatible_printers": [
        "elegoo_centauri_carbon",
        "elegoo_centauri_carbon_2"
      ],
      "requires_klipper": false,
      "notes": "Elegoo's four-spool, single-nozzle multi-colour feeder. Ships with the Centauri Carbon 2 Combo (and the Centauri 2 Combo); sold separately by the maker as a fitting add-on for the first Centauri Carbon (its own CANVAS product) and for the Centauri Carbon 2 / Centauri 2. 70s average per color change. RFID filament detection. Source: NotebookCheck CC2 review (Jan 2026) for the timing; the maker's two CANVAS product pages for the fit."
    }
  },
