{
  "_meta": {
    "version": "1.0.0",
    "domain": "fdm",
    "description": "Maps functional requirements to design constraints. When an agent describes what an object needs to DO, these rules translate into what the design needs to BE.",
    "_split_note": "Safety-floor profile for AI-controlled FDM printing.  Engineering depth (agent_guidance worked examples) is available in Kiln Pro; see https://kiln3d.com/pricing."
  },
  "load_bearing": {
    "display_name": "Supports Weight / Load-Bearing",
    "triggers": [
      "hold weight",
      "support",
      "load bearing",
      "carry",
      "mount",
      "hang",
      "shelf",
      "bracket",
      "hook",
      "strong enough",
      "mounting",
      "mounted",
      "hanging",
      "hanger",
      "carries",
      "carrying"
    ],
    "constraint_rules": {
      "material_exclude": [
        "pla",
        "tpu"
      ],
      "material_prefer": [
        "petg",
        "nylon",
        "abs",
        "polycarbonate"
      ],
      "min_wall_thickness_mm": 3,
      "infill_min_pct": 60,
      "print_orientation": "load_perpendicular_to_layers",
      "gussets_required": true,
      "fillets_required": true,
      "fillet_min_radius_mm": 2
    },
    "load_estimation_rules": {
      "petg_tension_capacity_n_per_mm2": 25,
      "abs_tension_capacity_n_per_mm2": 20,
      "nylon_tension_capacity_n_per_mm2": 35,
      "pc_tension_capacity_n_per_mm2": 32,
      "safety_factor": 3.0,
      "layer_bond_derating_pct": 40
    }
  },
