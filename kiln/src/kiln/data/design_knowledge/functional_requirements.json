        "pla",
        "abs",
        "asa"
      ],
      "material_exclude": [
        "nylon"
      ],
      "min_wall_shells": 4,
      "min_bottom_layers": 6,
      "line_width_overlap_pct": 5,
      "vase_mode_preferred": true,
      "max_layer_height_mm": 0.2
    }
  },
