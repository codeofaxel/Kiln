  "spur_gear": {
    "display_name": "Spur Gear",
    "library": "BOSL2",
    "import_line": "include <BOSL2/std.scad>\ninclude <BOSL2/gears.scad>",
    "example_call": "spur_gear(circ_pitch=5, teeth=20, thickness=8, shaft_diam=5);",
    "key_params": {
      "teeth": {
        "type": "int",
        "default": 20,
        "description": "number of teeth",
        "min": 6
      },
      "circ_pitch": {
        "type": "float",
        "default": 5,
        "description": "circular pitch in mm"
      },
      "thickness": {
        "type": "float",
        "default": 8,
        "description": "gear thickness in mm"
      },
      "shaft_diam": {
        "type": "float",
        "default": 5,
        "description": "center shaft hole diameter in mm"
      }
    },
    "agent_guidance": "Same circ_pitch for meshing. Calculate teeth ratio for speed reduction.",
    "printability_notes": "Print flat. Teeth under circ_pitch=3 won't resolve on 0.4mm nozzle. Use 0.12mm layers.",
    "category": "mechanical",
    "user_intents": [
      "gear",
      "cog",
      "toothed wheel",
      "cogwheel",
      "spur gear",
      "gears that mesh",
      "gear wheel",
      "pinion"
    ]
  },
