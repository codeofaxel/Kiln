{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kiln": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "kiln3d==1.5.0",
        "kiln",
        "serve"
      ],
      "env": {
        "KILN_UPDATE_COMMAND": "hermes plugins update kiln",
        "KILN_CLI": "uvx --from kiln3d==1.5.0 kiln",
        "KILN_TELEMETRY": "false"
      }
    }
  }
}
